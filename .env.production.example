# Variables de producción. Copia este archivo a .env.production y rellénalo.
# NUNCA subas .env.production al repositorio.

NODE_ENV=production
PORT=4000

# ---------- Base de datos ----------
# Usuario dueño de PostgreSQL: crea las bases de cada liceo, así que necesita
# permiso CREATEDB.
POSTGRES_USER=gestiedu
POSTGRES_PASSWORD=  # genera una larga y aleatoria
POSTGRES_DB=gestion_escolar_platform

# Base de la plataforma (liceos, superadmins, planes). Va directa a PostgreSQL.
PLATFORM_DATABASE_URL=postgresql://gestiedu:LA_MISMA_CONTRASENA@postgres:5432/gestion_escolar_platform

# Base por defecto para herramientas locales. En producción el backend usa la
# base de cada liceo, que resuelve solo.
DATABASE_URL=postgresql://gestiedu:LA_MISMA_CONTRASENA@postgres:5432/gestion_escolar_platform

# ---------- Conexiones (lo que permite escalar a muchos liceos) ----------
# Conexiones que abre el cliente de CADA liceo.
#
# Déjalo en 2. Medido en las dos formas posibles (ver docs/DESPLIEGUE.md §5):
# por la API no se nota la diferencia, y subirlo a 25 mide PEOR que 2 en ambas.
# Con pocos liceos en el servidor, 5 es el punto bueno. 25 nunca.
TENANT_CONNECTION_LIMIT=2
# PgBouncer reparte las conexiones reales: diez liceos pasan de 20 conexiones de
# PostgreSQL a 3. Déjalo vacío para conectar directo.
# Comprobado de verdad: npm run probar:pgbouncer
PGBOUNCER_HOST=pgbouncer
PGBOUNCER_PORT=6432

# El puerto lo manda este archivo, NO la variable PORT del entorno (una PORT
# suelta en la máquina ya tumbó el arranque una vez). Si el hospedaje asigna el
# puerto por variable, usa esta, que es explícita y nadie tiene suelta:
# PUERTO_DEL_HOST=8080

# ---------- Redis ----------
REDIS_PASSWORD=  # genera una larga y aleatoria
REDIS_URL=redis://:LA_MISMA_CONTRASENA@redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# ---------- Seguridad ----------
# Mínimo 32 caracteres cada uno. Genera con: openssl rand -base64 48
JWT_SECRET=
SUPERADMIN_JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Dominios del frontend separados por coma. No uses * en producción.
CORS_ORIGIN=https://gestiedu.com,https://www.gestiedu.com

# Dominio base: los liceos entran por subdominio (liceo.gestiedu.com)
BASE_DOMAIN=gestiedu.com
PLATFORM_NAME=GestiEdu

RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=60000

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=https://api.gestiedu.com

# ---------- Correo (opcional) ----------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
