# Environment variables for testing (PLANTILLA — copiar a .env.test y ajustar credenciales locales)
# NUNCA commitear .env.test con credenciales reales.

NODE_ENV=test

# Database (PostgreSQL)
# Reemplazar <USUARIO>:<PASSWORD> por las credenciales locales de Postgres.
# La BD tenant_test-load-5k y gestion_escolar_platform se crean automáticamente
# por tests/jest.globalSetup.js (migrate deploy / db push).
DATABASE_URL="postgresql://<USUARIO>:<PASSWORD>@localhost:5432/tenant_test-load-5k"
PLATFORM_DATABASE_URL="postgresql://<USUARIO>:<PASSWORD>@localhost:5432/gestion_escolar_platform"

# JWT Secrets (usar secrets diferentes para tests)
JWT_SECRET="test-jwt-secret-key-do-not-use-in-production"
JWT_REFRESH_SECRET="test-refresh-secret-key-do-not-use-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Redis (opcional, puede usar mock)
REDIS_URL="redis://localhost:6379"
REDIS_PUB_URL="redis://localhost:6379"
REDIS_SUB_URL="redis://localhost:6379"

# CORS
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# Server
PORT=3001

# Upload
MAX_FILE_SIZE=5242880

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=60000