{
  "name": "gestion-escolar-backend",
  "version": "1.0.0",
  "description": "Backend API para Sistema de Gestión Escolar Single-Tenant",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:prod": "cross-env NODE_ENV=production node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "migrate:tenants": "tsx src/scripts/migrate-all-tenants.ts",
    "migrate:tenants:status": "tsx src/scripts/migrate-all-tenants.ts --status",
    "db:migrate:reset": "prisma migrate reset",
    "db:seed": "tsx src/prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:setup": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "db:reset": "npm run db:migrate:reset && npm run db:seed",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:load": "tsx src/scripts/load-test.ts",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "docker:dev": "docker-compose -f ../../docker-compose.yml up -d",
    "docker:prod": "docker-compose -f ../../docker-compose.prod.yml up -d",
    "docker:down": "docker-compose -f ../../docker-compose.yml down",
    "docker:logs": "docker-compose -f ../../docker-compose.yml logs -f",
    "setup": "node setup.js",
    "migrate:preflight": "tsx src/migration/scripts/0-preflight-checks.ts",
    "migrate:backup": "tsx src/migration/scripts/backup-database.ts",
    "migrate:provision": "tsx src/migration/scripts/1-provision-databases.ts",
    "migrate:provision:dry": "tsx src/migration/scripts/1-provision-databases.ts --dry-run --verbose",
    "migrate:data": "tsx src/migration/scripts/2-migrate-data.ts",
    "migrate:data:dry": "tsx src/migration/scripts/2-migrate-data.ts --dry-run --verbose",
    "migrate:validate": "tsx src/migration/scripts/3-validate-migration.ts",
    "migrate:rollback": "tsx src/migration/scripts/4-rollback-migration.ts",
    "migrate:test": "tsx src/migration/scripts/test-local.ts",
    "papelera:limpiar": "tsx src/scripts/limpiar-papelera.ts",
    "backup:tenants": "tsx src/scripts/respaldar-liceos.ts",
    "restore:tenant": "tsx src/scripts/restaurar-liceo.ts",
    "medir:pantallas": "tsx src/scripts/medir-pantallas.ts",
    "medir:concurrencia": "tsx src/scripts/medir-concurrencia.ts",
    "medir:guardado": "tsx src/scripts/medir-guardado.ts",
    "contar:consultas": "tsx src/scripts/contar-consultas.ts",
    "probar:pgbouncer": "tsx src/scripts/probar-pgbouncer.ts",
    "medir:pozo": "tsx src/scripts/medir-pozo-y-repartidor.ts",
    "medir:aguante": "tsx src/scripts/medir-aguante.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/client": "^6.19.2",
    "@socket.io/redis-adapter": "^8.2.1",
    "@types/pg": "^8.16.0",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "dayjs": "^1.11.10",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.7.4",
    "fastify-multer": "^2.0.3",
    "ioredis": "^5.3.2",
    "isomorphic-dompurify": "2.35.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.17.1",
    "pg": "^8.18.0",
    "socket.io": "^4.7.4",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@asamuzakjp/css-color": "^4.1.1",
    "@types/bcrypt": "^5.0.2",
    "@types/exceljs": "^0.5.3",
    "@types/jest": "^29.5.8",
    "@types/jsdom": "^27.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.8.10",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.14",
    "@types/pdfkit": "^0.17.2",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "chalk": "^4.1.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "30.2.0",
    "jest-mock-extended": "^3.0.5",
    "jsdom": "^28.0.0",
    "prettier": "^3.0.3",
    "prisma": "^6.19.2",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "tsx": "^4.1.1",
    "typescript": "^5.2.2"
  },
  "prisma": {
    "schema": "src/prisma/schema.prisma",
    "seed": "tsx src/prisma/seed.ts"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "fastify",
    "prisma",
    "postgresql",
    "school-management",
    "single-tenant",
    "api",
    "typescript"
  ],
  "author": "Tu Nombre",
  "license": "MIT"
}
