# Migration Environment Variables Template
# Copy this to .env and fill in your actual values

# ============================================
# SOURCE DATABASE (Current single database)
# ============================================
DATABASE_URL="postgresql://user:password@localhost:5432/current_database"

# ============================================
# PLATFORM DATABASE (Metadata)
# ============================================
PLATFORM_DATABASE_URL="postgresql://user:password@localhost:5432/platform_db"

# ============================================
# TENANT DATABASE TEMPLATE
# ============================================
# This is used as a template to create tenant databases
# The actual database name will be: tenant_{slug}
TENANT_DATABASE_TEMPLATE="postgresql://user:password@localhost:5432/template_db"

# ============================================
# MIGRATION OPTIONS
# ============================================
# Set to 'true' to enable verbose logging
VERBOSE=false

# ============================================
# EXAMPLE FOR LOCAL DEVELOPMENT
# ============================================
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestiedu"
# PLATFORM_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestiedu_platform"
# TENANT_DATABASE_TEMPLATE="postgresql://postgres:postgres@localhost:5432/template"

# ============================================
# EXAMPLE FOR PRODUCTION
# ============================================
# DATABASE_URL="postgresql://prod_user:secure_pass@db.example.com:5432/gestiedu_prod"
# PLATFORM_DATABASE_URL="postgresql://prod_user:secure_pass@db.example.com:5432/gestiedu_platform"
# TENANT_DATABASE_TEMPLATE="postgresql://prod_user:secure_pass@db.example.com:5432/template"
