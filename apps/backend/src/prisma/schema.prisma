// apps/backend/src/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================
// ENUMS (PostgreSQL nativo)
// =====================================================

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
  TUTOR
}

enum Gender {
  MASCULINO
  FEMENINO
  OTRO
}

enum AcademicYearStatus {
  ACTIVE
  COMPLETED
  UPCOMING
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum InstituteStatus {
  ACTIVE
  SUSPENDED
  PENDING
  INACTIVE
}

enum PlanType {
  BASIC
  STANDARD
  PREMIUM
}

// =====================================================
// SUPERADMIN — Tabla completamente separada
// =====================================================

model SuperAdmin {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String
  isActive  Boolean   @default(true)
  lastLogin DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens SuperAdminRefreshToken[]

  @@index([email])
  @@index([isActive])
  @@map("super_admins")
}

model SuperAdminRefreshToken {
  id           String     @id @default(cuid())
  token        String     @unique
  superAdminId String
  superAdmin   SuperAdmin @relation(fields: [superAdminId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime   @default(now())

  @@index([superAdminId])
  @@index([expiresAt])
  @@map("super_admin_refresh_tokens")
}

// =====================================================
// CONFIGURACIÓN GLOBAL DE PLATAFORMA (Singleton)
// =====================================================

model PlatformConfig {
  id              String   @id @default("platform")
  maintenanceMode Boolean  @default(false)
  defaultPlan     PlanType @default(BASIC)
  maxFreeStudents Int      @default(100)
  supportEmail    String   @default("soporte@tuapp.com")
  platformName    String   @default("GestiEdu")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_config")
}

// =====================================================
// MODELO DE INSTITUTO (MULTI-TENANT)
// =====================================================

model Institute {
  id        String  @id @default(cuid())
  name      String
  code      String
  // Opcional por decisión de producto: un instituto puede no tener email de contacto.
  // Debe seguir al espejo de `Institute.email` en plataforma/schema.prisma.
  email     String?
  phone     String?
  address   String?
  slug      String  @unique
  domain    String? @unique
  subdomain String? @unique

  // Estado y plan
  status      InstituteStatus @default(PENDING)
  plan        PlanType        @default(BASIC)
  maxStudents Int             @default(500)
  maxTeachers Int             @default(50)
  trialEndsAt DateTime?
  notes       String?

  // Conexión a base de datos del tenant
  databaseName     String? @unique
  databaseHost     String?
  databasePort     Int?    @default(5432)
  databaseUser     String?
  databasePassword String?

  // Ubicación
  timezone String  @default("America/Caracas")
  country  String  @default("VE")
  city     String?

  // Logos y branding
  logo           String?
  favicon        String?
  primaryColor   String? @default("#4F46E5")
  secondaryColor String? @default("#3B82F6")
  subjectPalette String?
  ministryLogo   String?
  ministryText   String? @default("República Bolivariana de Venezuela\nMinisterio del Poder Popular para la Educación")

  // Configuración académica
  customDomain String? @unique
  environment  String  @default("production")

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  users         User[]
  classrooms    Classroom[]
  subjects      Subject[]
  academicYears AcademicYear[]
  activities    Activity[]
  schedules     Schedule[]
  auditLogs     AuditLog[]
  notifications Notification[]
  observations  Observation[]
  invitations   InstituteInvitation[]
  webhookLogs   WebhookLog[]

  @@index([status])
  @@index([plan])
  @@index([slug])
  @@map("institutes")
}

model InstituteInvitation {
  id         String    @id @default(cuid())
  email      String
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?

  createdAt   DateTime   @default(now())
  institute   Institute? @relation(fields: [instituteId], references: [id])
  instituteId String?

  @@index([token])
  @@map("institute_invitations")
}

// =====================================================
// MODELOS DE USUARIOS Y AUTENTICACIÓN
// =====================================================

model User {
  id         String    @id // Cédula de identidad (CI) - definida por administrador
  email      String    @unique
  password   String
  firstName  String
  lastName   String
  phone      String?
  birthDate  DateTime?
  address    String?
  gender     Gender?
  avatar     String?
  role       UserRole
  isActive   Boolean   @default(true)
  status     String    @default("ACTIVE") // ACTIVE, ARCHIVED, DELETED
  archivedAt DateTime?
  joinDate   DateTime  @default(now())
  lastLogin  DateTime?

  // Campos específicos para profesores
  specialization String?

  // Campos específicos para estudiantes
  studentCode String?

  // Relación con instituto
  // Configuraciones del usuario
  preferences Json?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones específicas por rol
  // Como Profesor
  teacherClassrooms      TeacherClassroom[]
  createdActivities      Activity[]
  gradesGiven            Grade[]
  attendanceRecords      DailyAttendance[]
  classroomsAsTeacher    Classroom[]             @relation("ClassroomTeacher")
  subjectTeachings       ClassroomSubject[]      @relation("SubjectTeacher")
  subjectTeacherHistory  SubjectTeacherHistory[] @relation("SubjectTeacherHistory")
  schedules              Schedule[]              @relation("ScheduleTeacher")
  personalScheduleBlocks ScheduleBlock[]         @relation("ScheduleBlockTeacher")
  createdSchoolEvents    SchoolEvent[]           @relation("CreatedSchoolEvents")
  replacementsTaught     ClassReplacement[]      @relation("ReplacementTeacher")
  photo                  UserPhoto?
  paymentPlans           StudentPaymentPlan[]
  payments               Payment[]               @relation("PaymentStudent")

  // Como Estudiante
  studentClassrooms   StudentClassroom[]
  grades              Grade[]            @relation("StudentGrades")
  attendance          DailyAttendance[]  @relation("StudentAttendance")
  academicHistory     AcademicRecord[]
  studentTutorings    StudentTutor[]     @relation("StudentTutorStudent")
  observations        Observation[]
  createdObservations Observation[]      @relation("CreatedObservations")

  // Como Tutor
  children StudentTutor[] @relation("StudentTutorTutor")

  // Auditoría
  auditLogs AuditLog[]

  // Sesiones y tokens
  refreshTokens           RefreshToken[]
  llavesDeTelefono        DeviceKey[]
  // Asistencia por QR
  pasesDeListaAbiertos    PaseDeLista[]            @relation("PaseAbiertoPor")
  registrosDeAsistenciaQr RegistroDeAsistenciaQr[] @relation("RegistroQrAlumno")
  notasDeRevision         NotaDeRevision[]         @relation("RevisionAlumno")
  aparatoDeAsistencia     AparatoDelAlumno?

  // Notificaciones
  notifications Notification[]
  institute     Institute?     @relation(fields: [instituteId], references: [id])
  instituteId   String?

  // Índices
  @@index([email])
  @@index([role])
  @@index([isActive])
  @@index([studentCode])
  @@index([role, isActive])
  // Buscar y ordenar la lista de usuarios sin recorrer la tabla entera
  // (migración 20260923120000_busqueda_de_usuarios). Medido con 15.000
  // personas: buscar 14 ms → 0,1 ms; ordenar una página 16 ms → 0,5 ms.
  @@index([role, lastName, firstName], map: "users_role_lastName_firstName_idx")
  @@index([firstName(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_firstName_trgm_idx")
  @@index([lastName(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_lastName_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_email_trgm_idx")
  @@index([studentCode(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_studentCode_trgm_idx")
  @@index([id(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_id_trgm_idx")
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Datos de sesión de dispositivo
  userAgent  String?
  ip         String? // IP con la que se creó la sesión
  lastUsedAt DateTime  @default(now()) // último uso actualizado en cada refresh
  rememberMe Boolean   @default(false) // sliding expiration activa
  /// Cuándo se cambió por uno nuevo. Sigue valiendo unos segundos más: dos
  /// pestañas que renuevan a la vez mandan el mismo token y una se quedaría
  /// fuera. Ver `GRACIA_DE_ROTACION_MS` en auth.service.ts.
  replacedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// LA LLAVE QUE GUARDA UN TELÉFONO PARA VOLVER A ENTRAR
///
/// No sirve para entrar por primera vez: se crea DESPUÉS de una entrada con
/// correo y contraseña, en ese teléfono y solo si su dueño lo pide. Lo que
/// hace la huella es abrir el cajón donde el teléfono la guardó (el almacén de
/// claves de Android, respaldado por hardware); la huella no viaja a ningún
/// sitio ni se guarda aquí.
///
/// Tres cosas la hacen segura, y las tres importan:
///   · aquí se guarda **solo el resumen** (SHA-256). Quien se lleve la base de
///     datos no se lleva ninguna llave;
///   · **se cambia en cada uso**, como la de volver a entrar: una copia robada
///     deja de valer en cuanto su dueño abre la app;
///   · caduca sola, y al cerrar sesión se anula.
model DeviceKey {
  id        String @id @default(cuid())
  /// SHA-256 de la llave. La llave en claro solo existe en el teléfono.
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// «Android · Chrome», para que se reconozca en la lista de sesiones.
  label String?

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
  @@index([expiresAt])
  @@map("device_keys")
}

// =====================================================
// MODELOS ACADÉMICOS
// =====================================================

model AcademicYear {
  id        String             @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean            @default(false)
  status    AcademicYearStatus @default(UPCOMING)

  // Instituto
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  periods          Period[]
  classrooms       Classroom[]
  academicRecords  AcademicRecord[]
  enrollments      StudentClassroom[]
  subjectResources SubjectResource[]
  paymentPlans     StudentPaymentPlan[]
  payments         Payment[]
  schoolEvents     SchoolEvent[]
  notasDeRevision  NotaDeRevision[]
  institute        Institute?           @relation(fields: [instituteId], references: [id])
  instituteId      String?

  @@unique([name])
  @@map("academic_years")
}

model Period {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  grades     Grade[]
  activities Activity[]

  @@unique([academicYearId, name])
  @@map("periods")
}

model Subject {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  code        String?
  description String?
  color       String?

  // Instituto
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  classroomSubjects  ClassroomSubject[]
  activities         Activity[]
  grades             Grade[]
  schedules          Schedule[]
  classSessions      ClassSession[]
  pasesDeLista       PaseDeLista[]
  classActivities    ClassActivity[]
  resources          SubjectResource[]
  evaluationPlanRows EvaluationPlanRow[]
  replacedIn         ClassReplacement[]  @relation("ReplacementSuspendedSubject")
  replacingIn        ClassReplacement[]  @relation("ReplacementSubject")
  observations       Observation[]
  notasDeRevision    NotaDeRevision[]
  institute          Institute?          @relation(fields: [instituteId], references: [id])
  instituteId        String?

  @@unique([name])
  @@map("subjects")
}

model SubjectResource {
  id   String @id @default(cuid())
  name String
  url  String
  type String @default("SYLLABUS")

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([subjectId, academicYearId])
  @@map("subject_resources")
}

model Classroom {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  section     String
  grade       Int
  capacity    Int?
  shift       String  @default("MANANA") // "MANANA" | "TARDE" | "INTEGRAL"
  isActive    Boolean @default(true)

  // Instituto
  // Profesor principal asignado
  teacherId String?
  teacher   User?   @relation("ClassroomTeacher", fields: [teacherId], references: [id], onDelete: SetNull)

  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  teachers           TeacherClassroom[]
  studentClassrooms  StudentClassroom[]
  subjects           ClassroomSubject[]
  activities         Activity[]
  schedules          Schedule[]
  attendanceRecords  DailyAttendance[]
  scheduleBlocks     ScheduleBlock[]     @relation("ClassroomScheduleBlocks")
  classSessions      ClassSession[]
  pasesDeLista       PaseDeLista[]
  classActivities    ClassActivity[]
  evaluationPlanRows EvaluationPlanRow[]
  replacements       ClassReplacement[]
  observations       Observation[]
  institute          Institute?          @relation(fields: [instituteId], references: [id])
  instituteId        String?

  @@unique([academicYearId, name, section])
  @@index([academicYearId])
  @@index([teacherId])
  @@index([grade])
  @@index([shift])
  @@map("classrooms")
}

// =====================================================
// MODELOS DE RELACIONES MANY-TO-MANY
// =====================================================

model TeacherClassroom {
  id String @id @default(cuid())

  teacherId String
  teacher   User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  isMainTeacher Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teacherId, classroomId])
  @@index([teacherId])
  @@index([classroomId])
  @@map("teacher_classrooms")
}

model StudentClassroom {
  id String @id @default(cuid())

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  enrollmentDate DateTime @default(now())
  isActive       Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, academicYearId])
  @@index([studentId, isActive])
  @@index([academicYearId, isActive])
  @@index([classroomId, academicYearId, isActive])
  @@map("student_classrooms")
}

model ClassroomSubject {
  id String @id @default(cuid())

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  teacherId String?
  teacher   User?   @relation("SubjectTeacher", fields: [teacherId], references: [id], onDelete: SetNull)

  weeklyBlocks Int   @default(0)
  hoursPerWeek Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacherHistory SubjectTeacherHistory[]
  scheduleBlocks ScheduleBlock[]

  @@unique([classroomId, subjectId])
  @@index([teacherId])
  @@index([subjectId])
  @@map("classroom_subjects")
}

model SubjectTeacherHistory {
  id String @id @default(cuid())

  classroomSubjectId String
  classroomSubject   ClassroomSubject @relation(fields: [classroomSubjectId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   User   @relation("SubjectTeacherHistory", fields: [teacherId], references: [id], onDelete: Cascade)

  startDate DateTime  @default(now())
  endDate   DateTime?
  isActive  Boolean   @default(true)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classroomSubjectId, isActive])
  @@map("subject_teacher_history")
}

/// Un bloque de la cuadrícula del horario. Dos formas, una sola tabla —
/// `blockType` discrimina:
///
///   CLASS    → una clase. Cuelga de `classroomSubject` (sección + materia +
///              profesor), que es la asignación que hace el admin. Por eso el
///              horario de la sección y el del profesor son la misma tabla
///              vista desde dos lados.
///   PERSONAL → hora propia del profesor (planificación, guardia…). No tiene
///              sección ni materia: la crea el admin desde el horario del
///              profesor, con `title` y `notes`, y pertenece a `teacher`.
///
/// Viven juntos a propósito: la pregunta "¿está ocupada esta hora de este
/// profesor?" tiene que responderse con UNA consulta. Si estuvieran en tablas
/// distintas, cada camino que valida horarios tendría que acordarse de mirar
/// las dos, y olvidarlo fallaría en silencio (colocar una clase encima de la
/// hora personal de alguien).
model ScheduleBlock {
  id String @id @default(cuid())

  /// Nulo en los bloques PERSONAL: no pertenecen a ninguna sección.
  classroomId String?
  classroom   Classroom? @relation("ClassroomScheduleBlocks", fields: [classroomId], references: [id], onDelete: Cascade)

  classroomSubjectId String?
  classroomSubject   ClassroomSubject? @relation(fields: [classroomSubjectId], references: [id], onDelete: SetNull)

  /// Dueño del bloque PERSONAL. En los CLASS el profesor se obtiene a través
  /// de `classroomSubject.teacherId`, no aquí.
  teacherId String?
  teacher   User?   @relation("ScheduleBlockTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  dayOfWeek Int
  startTime String
  endTime   String
  blockType String  @default("CLASS")
  /// Solo en los PERSONAL: el título que le pone el admin.
  title     String?
  location  String?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classroomId, dayOfWeek])
  @@index([classroomSubjectId])
  @@index([classroomId, dayOfWeek, startTime])
  @@index([teacherId, dayOfWeek])
  @@map("schedule_blocks")
}

model StudentTutor {
  id String @id @default(cuid())

  studentId String
  student   User   @relation("StudentTutorStudent", fields: [studentId], references: [id], onDelete: Cascade)

  tutorId String
  tutor   User   @relation("StudentTutorTutor", fields: [tutorId], references: [id], onDelete: Cascade)

  relationship String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, tutorId])
  @@index([tutorId])
  @@map("student_tutors")
}

// =====================================================
// MODELOS DE ACTIVIDADES Y CALENDARIO
// =====================================================

model Activity {
  id          String  @id @default(cuid())
  title       String
  name        String?
  description String?
  type        String
  scope       String

  startDate DateTime
  endDate   DateTime?
  dueDate   DateTime?

  maxGrade  Float   @default(20)
  weight    Float   @default(1)
  isActive  Boolean @default(true)
  isVisible Boolean @default(true)

  // Campos del Plan de Evaluación Venezolano
  temaGenerador  String?
  tejidoTematico String?
  referentes     String?
  tecnicas       String?
  instrumentos   String?
  criterios      String?
  lapso          String? @default("1")

  // Instituto
  // Relaciones académicas
  periodId    String?
  period      Period?    @relation(fields: [periodId], references: [id], onDelete: SetNull)
  subjectId   String?
  subject     Subject?   @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  classroomId String?
  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)

  createdBy String
  creator   User   @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grades      Grade[]
  planRow     EvaluationPlanRow?
  institute   Institute?         @relation(fields: [instituteId], references: [id])
  instituteId String?

  orderIndex Int @default(0)

  @@index([classroomId])
  @@index([subjectId])
  @@index([periodId])
  @@index([createdBy])
  @@index([startDate])
  @@index([classroomId, periodId])
  @@index([subjectId, periodId])
  @@index([isActive, dueDate])
  @@map("activities")
}

model EvaluationPlanMetadata {
  id          String @id @default(cuid())
  classroomId String
  subjectId   String
  lapso       String

  // Membrete (auto-llenado, editable)
  nombreDocente   String?
  cedulaDocente   String?
  telefonoDocente String?
  correoDocente   String?
  areaFormacion   String?
  annoSeccion     String?
  periodoEscolar  String?
  totalSemanas    Int?
  fechaDesde      DateTime?
  fechaHasta      DateTime?

  // Campos del plan
  peic              String?
  enfasisCurricular String?
  referentesEticos  String?
  intencionalidad   String?
  temaIndispensable String?

  // Observaciones y firmas
  observaciones String?

  // Nombres de columnas personalizadas (JSON o texto plano separado por comas)
  customColumns String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classroomId, subjectId, lapso])
  @@map("evaluation_plan_metadata")
}

model EvaluationPlanRow {
  id String @id @default(cuid())

  // Identificación del plan
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lapso       String

  // Estructura
  rowType       String // "HEADER" | "FIELD" | "EVALUATION" | "TEXT" | "INDICATORS"
  weekNumber    Int
  endWeekNumber Int? // Para permitir que una fila abarque desde weekNumber hasta endWeekNumber
  orderIndex    Int    @default(0)

  // HEADER fields
  title        String?
  headingLevel Int? // 1, 2, 3

  // FIELD fields
  label   String?
  content String?

  // TEXT fields
  textContent String?

  // EVALUATION fields (campos fijos)
  actividadEval  String?
  tecnicas       String?
  instrumentos   String?
  criterios      String?
  ponderacion    Float? // % del total
  puntos         Float? // Puntos
  tipoEvaluacion String? // "FORMATIVA" | "SUMATIVA" | "DIAGNOSTICA"

  // INDICATORS fields (JSON desglose)
  indicadores String? // JSON: {"SER": 1, "HACER": 2, ...}

  // Datos extra para columnas personalizadas (JSON)
  extraData String?

  // Actividades de Clase en Vivo vinculadas a este criterio/bloque
  classActivities ClassActivity[]

  // Link a Activity para calificaciones
  activityId String?   @unique
  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classroomId, subjectId, lapso])
  @@index([classroomId, subjectId, lapso, weekNumber])
  @@map("evaluation_plan_rows")
}

// =====================================================
// MODELOS DE CALIFICACIONES
// =====================================================

model Grade {
  id       String  @id @default(cuid())
  score    Float? // Opcional para actividades consolidadas
  scores   Json? // Para múltiples actividades consolidadas
  comments String?
  metadata Json? // feedback largo, attachments, historial

  studentId  String
  student    User     @relation("StudentGrades", fields: [studentId], references: [id], onDelete: Cascade)
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  periodId   String
  period     Period   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId  String
  teacher    User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, activityId])
  @@index([studentId, subjectId, periodId])
  @@index([subjectId, periodId])
  @@index([activityId])
  @@index([teacherId])
  @@index([teacherId, createdAt(sort: Desc)])
  @@map("grades")
}

// =====================================================
// MODELOS DE ASISTENCIA
// =====================================================

model DailyAttendance {
  id      String           @id @default(cuid())
  date    DateTime         @db.Date // Solo fecha, sin hora
  status  AttendanceStatus @default(PRESENT)
  periods Int              @default(0) // Bitfield para 8 períodos (0-255)

  // Campos opcionales para detalles
  lateArrival Int? // Minutos de retraso
  earlyLeave  Int? // Minutos de salida temprana
  excuseNote  String? // Nota de justificación
  comments    String?

  studentId   String
  student     User      @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     User      @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  classSessionId String?
  classSession   ClassSession? @relation(fields: [classSessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, date])
  @@index([studentId, classroomId])
  @@index([classroomId, date])
  @@index([studentId, date(sort: Desc)])
  @@index([teacherId])
  @@index([classSessionId])
  @@map("daily_attendance")
}

// =====================================================
// MODELOS DE HORARIOS
// =====================================================

model Schedule {
  id        String  @id @default(cuid())
  dayOfWeek String
  startTime String
  endTime   String
  room      String?
  notes     String?

  // Instituto
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     User      @relation("ScheduleTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  institute   Institute? @relation(fields: [instituteId], references: [id])
  instituteId String?

  @@unique([classroomId, subjectId, dayOfWeek, startTime])
  @@map("schedules")
}

// =====================================================
// MODELOS DE AUDITORÍA Y LOGS
// =====================================================

model AuditLog {
  id         String  @id @default(cuid())
  action     String
  entity     String
  entityType String
  entityId   String
  oldValues  Json?
  newValues  Json?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  level      String  @default("NORMAL") // CRITICAL, SECURITY, NORMAL

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Instituto (FK real)
  createdAt   DateTime   @default(now())
  institute   Institute? @relation(fields: [instituteId], references: [id])
  instituteId String?

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([level, createdAt(sort: Desc)])
  @@index([entityType, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// =====================================================
// MODELOS DE NOTIFICACIONES
// =====================================================

model Notification {
  id       String @id @default(cuid())
  title    String
  message  String
  type     String
  priority String

  recipientId String
  recipient   User   @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  senderId  String?
  data      Json?
  actionUrl String?
  readAt    DateTime?
  emailSent Boolean   @default(false)

  // TTL para limpieza automática
  expiresAt  DateTime? // Null = sin expiración
  persistent Boolean   @default(false) // true = nunca expira

  // Instituto
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  institute   Institute? @relation(fields: [instituteId], references: [id])
  instituteId String?

  @@index([recipientId, readAt])
  @@index([type])
  @@index([createdAt(sort: Desc)])
  @@index([recipientId, createdAt(sort: Desc)])
  @@map("notifications")
}

// =====================================================
// MODELOS DE DASHBOARD DE ESTUDIANTE
// =====================================================

model Observation {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String   @default("OBSERVACION")
  date        DateTime @default(now())

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("CreatedObservations", fields: [createdById], references: [id], onDelete: Cascade)

  classroomId String?
  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  classSessionId String?
  classSession   ClassSession? @relation(fields: [classSessionId], references: [id], onDelete: SetNull)

  groupId String?

  // Instituto
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  institute   Institute? @relation(fields: [instituteId], references: [id])
  instituteId String?

  @@index([studentId])
  @@index([createdById])
  @@index([classroomId])
  @@index([subjectId])
  @@index([classSessionId])
  @@index([groupId])
  @@index([date])
  @@map("observations")
}

model AcademicRecord {
  id        String @id @default(cuid())
  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  sectionSnapshot String
  finalAverage    Float
  status          String

  // Fase 3.5-C — cierre de ciclo:
  //  - finalResult: PROMOVIDO | PROMOVIDO_CON_PENDIENTES | NO_PROMOVIDO (lo que
  //    dejó el admin tras la revisión, no la sugerencia automática)
  //  - pendingSubjects: materias pendientes (JSON array)
  //  - subjectGrades: desglose de promedio final por materia (JSON)
  //  - assignedClassroomId: sección asignada en el año siguiente (si aplica)
  finalResult         String?
  pendingSubjects     Json?
  subjectGrades       Json?
  assignedClassroomId String?

  createdAt DateTime @default(now())

  @@unique([studentId, academicYearId])
  @@map("academic_records")
}

/// LA REVISIÓN DE UNA MATERIA REPROBADA
///
/// Al terminar el tercer lapso, el alumno que reprobó una materia la presenta
/// en revisión; esa nota es su definitiva para la promoción. Se registra ANTES
/// de cerrar el ciclo y el cierre la usa. Ver `services/revision.service.ts`.
model NotaDeRevision {
  id String @id @default(cuid())

  studentId String
  student   User   @relation("RevisionAlumno", fields: [studentId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  score         Float
  fecha         DateTime @db.Date
  registradaPor String
  observaciones String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, subjectId, academicYearId])
  @@index([academicYearId])
  @@map("notas_de_revision")
}

// =====================================================
// MODELOS DE MONITOREO Y PERFORMANCE
// =====================================================

model QueryMetric {
  id        String   @id @default(cuid())
  model     String
  operation String
  duration  Int
  timestamp DateTime @default(now())
  severity  String

  totalQueries     Int?
  averageDuration  Int?
  slowQueriesCount Int?

  createdAt DateTime @default(now())

  @@index([timestamp])
  @@index([severity])
  @@index([model, operation])
  @@map("query_metrics")
}

model SystemAlert {
  id         String    @id @default(cuid())
  type       String
  severity   String
  message    String
  data       Json?
  resolved   Boolean   @default(false)
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([type, resolved])
  @@index([createdAt])
  @@index([severity, resolved])
  @@map("system_alerts")
}

// =====================================================
// MODELOS DE CLASES (SESIONES)
// =====================================================

// =====================================================
// EVENTOS DEL LICEO (actos, jornadas, reuniones…)
// =====================================================

/// Un evento que crea el director/admin sobre una franja de un día concreto.
///
/// Siempre suspende las clases que caen en su franja y su alcance (decisión de
/// producto). La suspensión se hace marcando la `ClassSession` de ese día como
/// SUSPENDED — el mismo estado que usa Clase en Vivo, que ya muestra "Clase
/// suspendida: <motivo>" — y se registra en `suspendedByEventId` para poder
/// deshacerla si el evento se borra o se mueve.
///
/// Alcance (`scope`):
///   INSTITUTE  → todas las secciones del ciclo escolar
///   GRADES     → las secciones de los años listados en `grades` (1 = 1er año…)
///   CLASSROOMS → las secciones listadas en `classroomIds`
model SchoolEvent {
  id          String  @id @default(cuid())
  title       String
  description String?

  date      DateTime @db.Date
  /// Franja cubierta: del inicio del primer bloque al fin del último.
  startTime String
  endTime   String

  scope        String   @default("INSTITUTE")
  grades       Int[]    @default([])
  classroomIds String[] @default([])

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("CreatedSchoolEvents", fields: [createdById], references: [id], onDelete: SetNull)

  suspendedSessions ClassSession[] @relation("EventSuspendedSessions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([academicYearId, date])
  @@index([date])
  @@map("school_events")
}

model ClassSession {
  id                 String   @id @default(cuid())
  publicId           String   @unique @default(cuid())
  date               DateTime @db.Date
  startTime          String?
  endTime            String?
  topic              String?
  observations       String?
  observationsTitle  String?
  involvedStudentIds String[] @default([])

  // Estado de la clase: ACTIVE | SUSPENDED
  status          String  @default("ACTIVE")
  suspendedReason String?

  /// Evento del liceo que suspendió esta clase, si fue uno. Permite revertir la
  /// suspensión al borrar o mover el evento sin tocar las suspensiones que hizo
  /// un profesor a mano (esas tienen este campo nulo).
  suspendedByEventId String?
  suspendedByEvent   SchoolEvent? @relation("EventSuspendedSessions", fields: [suspendedByEventId], references: [id], onDelete: SetNull)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  attendanceRecords DailyAttendance[]
  activities        ClassActivity[]
  observationsList  Observation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classroomId, subjectId, date])
  @@index([classroomId, subjectId])
  @@index([suspendedByEventId])
  @@index([date])
  @@index([classroomId, date])
  @@index([subjectId, date])
  @@map("class_sessions")
}

// =====================================================
// ASISTENCIA POR QR (ver services/asistencia-qr.service.ts)
// =====================================================

/// UN PASE DE LISTA POR QR
///
/// Lo abre el profesor (o el admin) en una clase: su teléfono enseña un código
/// que cambia cada 10 s y los alumnos lo escanean desde su app. Es solo la
/// forma de IDENTIFICAR al alumno: lo que queda es la asistencia de siempre
/// (`daily_attendance`), la misma que marca el profesor a mano.
model PaseDeLista {
  id String @id @default(cuid())

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  /// El día de la clase. Si es anterior a hoy, el pase es una CORRECCIÓN.
  fecha       DateTime  @db.Date

  abiertoPorId String
  abiertoPor   User   @relation("PaseAbiertoPor", fields: [abiertoPorId], references: [id], onDelete: Cascade)

  abiertoEn    DateTime  @default(now())
  /// Quien escanea después de esto entra como TARDE.
  aTiempoHasta DateTime
  /// Cierre de seguridad: un pase olvidado abierto no sirve para siempre.
  caducaEn     DateTime
  cerradoEn    DateTime?
  esCorreccion Boolean   @default(false)

  /// Firma los códigos que rotan. No sale nunca del servidor.
  secreto String

  /// El faro: dónde estaba el teléfono del profesor al abrirlo.
  latitud   Float?
  longitud  Float?
  precision Float?

  registros RegistroDeAsistenciaQr[]

  @@index([classroomId, subjectId, fecha])
  @@index([abiertoPorId, cerradoEn])
  @@map("pases_de_lista")
}

/// CADA INTENTO DE UN ALUMNO, ACEPTADO O NO
///
/// Si mañana hay un reclamo, aquí está con qué teléfono, a qué hora, desde
/// dónde y por qué se aceptó o se rechazó.
model RegistroDeAsistenciaQr {
  id String @id @default(cuid())

  paseId String
  pase   PaseDeLista @relation(fields: [paseId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("RegistroQrAlumno", fields: [studentId], references: [id], onDelete: Cascade)

  /// ALUMNO_ESCANEA (el alumno escanea el QR del profesor) | PROFESOR_ESCANEA
  forma  String
  /// ACEPTADO | POR_CONFIRMAR | RECHAZADO | QUITADO
  estado String
  /// Por qué no se aceptó a la primera (OTRO_TELEFONO, FUERA_DEL_RADIO…).
  motivo String?

  /// Lo que se le puso: PRESENT o LATE.
  asistencia         String?
  /// Lo que tenía antes, para devolverlo si el profesor lo quita (corrección).
  asistenciaAnterior String?

  /// Resumen del identificador del aparato (nunca el identificador en claro).
  aparatoHash String?
  aparato     String?

  latitud        Float?
  longitud       Float?
  precision      Float?
  distancia      Float?
  ubicacionFalsa Boolean @default(false)

  creadoEn      DateTime  @default(now())
  resueltoPorId String?
  resueltoEn    DateTime?

  @@index([paseId])
  @@index([studentId])
  @@index([aparatoHash])
  @@map("registros_asistencia_qr")
}

/// EL TELÉFONO DE CADA ALUMNO PARA LA ASISTENCIA
///
/// Una cuenta, un teléfono. El primero desde el que un alumno pasa asistencia
/// queda suyo; un teléfono, de un alumno. Si lo cambia, el admin lo desbloquea
/// desde su perfil (y queda anotado en `audit_logs`).
model AparatoDelAlumno {
  studentId String @id
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  aparatoHash  String   @unique
  descripcion  String?
  registradoEn DateTime @default(now())
  ultimoUso    DateTime @default(now())

  @@map("aparatos_de_alumnos")
}

// =====================================================
// PAGOS (módulo que el liceo activa en Configuración)
// =====================================================

/// CONFIGURACIÓN DE PAGOS DEL LICEO
///
/// Una sola fila (`id = "liceo"`). Todo configurable: nada de montos, monedas
/// ni frecuencias fijas en el código. Las reglas de cálculo están en
/// `services/pagos.service.ts` y en docs/MAPA_DE_CALCULOS.md.
model PaymentSettings {
  id      String  @id @default("liceo")
  enabled Boolean @default(false)

  /// MONTHLY | BIWEEKLY | PER_PERIOD
  frequency String @default("MONTHLY")
  /// SAME_DAY (todos el mismo día) | PER_STUDENT (cada alumno su día)
  dueMode   String @default("SAME_DAY")
  /// Día del mes en que vence (1–28). En quincenal, vence este día y 15 días después.
  dueDay    Int    @default(5)
  graceDays Int    @default(0)

  /// Moneda en que se fijan los montos: USD | VES
  baseCurrency       String @default("USD")
  /// Monedas en que se aceptan los pagos: USD | VES | BOTH
  acceptedCurrencies String @default("BOTH")

  feeAmount Decimal @default(0) @db.Decimal(12, 2)

  enrollmentEnabled Boolean @default(false)
  enrollmentAmount  Decimal @default(0) @db.Decimal(12, 2)

  /// Métodos de pago que ofrece el liceo (lista de textos).
  methods Json @default("[\"Efectivo\", \"Pago Móvil\", \"Transferencia\", \"Zelle\"]")

  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("payment_settings")
}

/// Lo particular de un alumno en un ciclo: su día de pago (si cada uno tiene el
/// suyo) y si está exonerado o becado.
model StudentPaymentPlan {
  id String @id @default(cuid())

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  dueDay       Int?
  exempt       Boolean @default(false)
  exemptReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, academicYearId])
  @@index([academicYearId])
  @@map("student_payment_plans")
}

/// UN PAGO RECIBIDO
///
/// No se borra nunca: un pago mal registrado se ANULA con motivo, y queda a la
/// vista quién lo registró y quién lo anuló.
model Payment {
  id            String @id @default(cuid())
  /// Número correlativo del comprobante dentro del liceo.
  receiptNumber Int    @unique @default(autoincrement())

  studentId String
  student   User   @relation("PaymentStudent", fields: [studentId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  paidAt    DateTime @db.Date
  method    String
  reference String?
  notes     String?

  /// Lo que entregó el representante, en su moneda.
  currency     String
  amount       Decimal  @db.Decimal(12, 2)
  /// Bolívares por dólar, cuando se paga en una moneda distinta a la base.
  exchangeRate Decimal? @db.Decimal(14, 4)
  /// El mismo monto llevado a la moneda base: es lo que se reparte en cuotas.
  amountBase   Decimal  @db.Decimal(12, 2)

  createdById String?

  annulledAt   DateTime?
  annulledById String?
  annulReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations PaymentAllocation[]

  @@index([studentId, academicYearId])
  @@index([academicYearId, annulledAt])
  @@map("payments")
}

/// Cuánto de un pago va a cada cuota. Permite abonos: una cuota puede tener
/// varios repartos que juntos la completan.
model PaymentAllocation {
  id String @id @default(cuid())

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  /// "INS", "2026-09", "2026-09-2" (2ª quincena), "P:<periodId>".
  installmentKey String
  amountBase     Decimal @db.Decimal(12, 2)

  @@index([paymentId])
  @@index([installmentKey])
  @@map("payment_allocations")
}

/// FOTO DE PERFIL
///
/// Se guarda en la base del liceo y no en una carpeta: viaja con el respaldo y
/// no hay forma de pedir la de otro liceo cambiando una dirección. Nunca es la
/// imagen que se subió: el servidor la redibuja a 256×256 en WebP (unos 15 KB),
/// lo que de paso tira los metadatos (la ubicación GPS de la foto del teléfono)
/// y cualquier cosa escondida dentro del archivo original.
model UserPhoto {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  data    Bytes
  /// Huella corta del contenido: cambia con cada foto, para que el navegador
  /// no enseñe la vieja guardada.
  version String
  size    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_photos")
}

/// REEMPLAZO DE UNA CLASE SUSPENDIDA
///
/// Cuando el admin suspende una clase puede poner OTRA materia de la misma
/// sección en ese hueco (un profesor faltó y otro adelanta su clase). Es una
/// fila por bloque del horario que se cubre, en una fecha concreta: el horario
/// semanal no cambia.
///
/// El profesor es el de la materia que entra (`classroomSubject.teacherId`)
/// copiado aquí, para que sus permisos de pasar asistencia y poner notas sean
/// los de siempre: da esa materia en esa sección.
///
/// La clase que se da es la sesión normal de esa materia ese día
/// (`ClassSession` es única por sección + materia + día).
model ClassReplacement {
  id String @id @default(cuid())

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  date      DateTime @db.Date
  startTime String
  endTime   String

  /// La materia suspendida cuyo hueco se cubre.
  suspendedSubjectId String
  suspendedSubject   Subject @relation("ReplacementSuspendedSubject", fields: [suspendedSubjectId], references: [id], onDelete: Cascade)

  /// La materia que entra en su lugar.
  subjectId String
  subject   Subject @relation("ReplacementSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   User   @relation("ReplacementTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  reason      String?
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classroomId, date, startTime])
  @@index([teacherId, date])
  @@index([classroomId, date])
  @@map("class_replacements")
}

// =====================================================
// ACTIVIDADES / TAREAS POR CLASE
// =====================================================

model ClassActivity {
  id          String    @id @default(cuid())
  title       String
  description String?
  type        String    @default("TAREA") // TAREA | EXAMEN | ACTIVIDAD
  target      String    @default("NEXT") // CURRENT (esta clase) | NEXT (próxima clase)
  tag         String? // Etiqueta personalizada (ej: Examen, Taller, Tarea, Proyecto...)
  dueDate     DateTime? // Fecha asignada o fecha límite
  maxScore    Float?    @default(20)
  scores      Json? // Mapa de puntajes por estudiante: { "studentId": score }
  isDone      Boolean   @default(false)
  carriedOver Boolean   @default(false) // true si fue movida por suspensión

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  // Vinculación de la actividad al criterio/bloque del plan de evaluación
  // (fila EVALUATION de la semana). Cada actividad de la Clase en Vivo pertenece
  // a un criterio del plan y participa en su cálculo ponderado.
  planRowId String?
  planRow   EvaluationPlanRow? @relation(fields: [planRowId], references: [id], onDelete: SetNull)

  classSessionId String?
  classSession   ClassSession? @relation(fields: [classSessionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classroomId, subjectId])
  @@index([classSessionId])
  @@index([classroomId, subjectId, target])
  @@map("class_activities")
}

// =====================================================
// WEBHOOK LOGS (Eventos del sistema)
// =====================================================

model WebhookLog {
  id          String     @id @default(cuid())
  event       String // INSTITUTE_CREATED, INSTITUTE_SUSPENDED, LIMIT_REACHED, etc.
  data        Json?
  createdAt   DateTime   @default(now())
  institute   Institute? @relation(fields: [instituteId], references: [id])
  instituteId String?

  @@index([event])
  @@index([createdAt])
  @@map("webhook_logs")
}

// =====================================================
// PAPELERA (nada se borra de verdad)
// =====================================================
//
// Antes de borrar una fila se guarda aquí una copia completa tal como estaba.
// No cambia cómo se consulta nada —las pantallas siguen igual— pero deja que un
// borrado por error se pueda deshacer.
//
// Un borrado equivocado de notas o de asistencia no se recupera de ningún otro
// sitio salvo del respaldo de anoche, que se lleva por delante todo lo del día.
// Esto es la red de seguridad del día en curso.

model RegistroBorrado {
  id         String @id @default(cuid())
  /// Nombre del modelo Prisma: "grade", "dailyAttendance", "observation"...
  tabla      String
  /// El id que tenía la fila borrada.
  registroId String
  /// La fila entera tal como estaba justo antes de borrarse.
  contenido  Json

  /// Quién lo borró y desde dónde, para poder preguntarle.
  borradoPor String?
  motivo     String?

  createdAt DateTime @default(now())

  @@index([tabla, registroId])
  @@index([createdAt])
  @@index([tabla, createdAt(sort: Desc)])
  @@map("registros_borrados")
}
