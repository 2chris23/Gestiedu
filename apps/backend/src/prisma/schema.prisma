// apps/backend/src/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================
// ENUMS (PostgreSQL nativo)
// =====================================================

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
  TUTOR
}

enum Gender {
  MASCULINO
  FEMENINO
  OTRO
}

/// Cómo se evalúa una materia: con nota de 01 a 20, o con una apreciación
/// (Orientación y Convivencia, Grupos de Creación…). Las cualitativas no
/// entran en ningún promedio ni en la promoción.
enum EvaluacionDeMateria {
  NUMERICA
  CUALITATIVA
}

enum AcademicYearStatus {
  ACTIVE
  COMPLETED
  UPCOMING
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum InstituteStatus {
  ACTIVE
  SUSPENDED
  PENDING
  INACTIVE
}

enum PlanType {
  BASIC
  STANDARD
  PREMIUM
}

// =====================================================
// SUPERADMIN — Tabla completamente separada
// =====================================================

model SuperAdmin {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String
  isActive  Boolean   @default(true)
  lastLogin DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens SuperAdminRefreshToken[]

  @@index([email])
  @@index([isActive])
  @@map("super_admins")
}

model SuperAdminRefreshToken {
  id           String     @id @default(cuid())
  token        String     @unique
  superAdminId String
  superAdmin   SuperAdmin @relation(fields: [superAdminId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime   @default(now())

  @@index([superAdminId])
  @@index([expiresAt])
  @@map("super_admin_refresh_tokens")
}

// =====================================================
// CONFIGURACIÓN GLOBAL DE PLATAFORMA (Singleton)
// =====================================================

model PlatformConfig {
  id              String   @id @default("platform")
  maintenanceMode Boolean  @default(false)
  defaultPlan     PlanType @default(BASIC)
  maxFreeStudents Int      @default(100)
  supportEmail    String   @default("soporte@tuapp.com")
  platformName    String   @default("GestiEdu")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_config")
}

// =====================================================
// MODELO DE INSTITUTO (MULTI-TENANT)
// =====================================================

model Institute {
  id        String  @id @default(cuid())
  name      String
  code      String
  // Opcional por decisión de producto: un instituto puede no tener email de contacto.
  // Debe seguir al espejo de `Institute.email` en plataforma/schema.prisma.
  email     String?
  phone     String?
  address   String?
  slug      String  @unique
  domain    String? @unique
  subdomain String? @unique

  // Estado y plan
  status      InstituteStatus @default(PENDING)
  plan        PlanType        @default(BASIC)
  maxStudents Int             @default(500)
  maxTeachers Int             @default(50)
  trialEndsAt DateTime?
  notes       String?

  // Conexión a base de datos del tenant
  databaseName     String? @unique
  databaseHost     String?
  databasePort     Int?    @default(5432)
  databaseUser     String?
  databasePassword String?

  // Ubicación
  timezone String  @default("America/Caracas")
  country  String  @default("VE")
  city     String?

  // Logos y branding
  logo           String?
  favicon        String?
  primaryColor   String? @default("#4F46E5")
  secondaryColor String? @default("#3B82F6")
  subjectPalette String?
  ministryLogo   String?
  ministryText   String? @default("República Bolivariana de Venezuela\nMinisterio del Poder Popular para la Educación")

  // Configuración académica
  customDomain String? @unique
  environment  String  @default("production")

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  users         User[]
  classrooms    Classroom[]
  subjects      Subject[]
  academicYears AcademicYear[]
  activities    Activity[]
  schedules     Schedule[]
  auditLogs     AuditLog[]
  notifications Notification[]
  observations  Observation[]
  invitations   InstituteInvitation[]
  webhookLogs   WebhookLog[]

  @@index([status])
  @@index([plan])
  @@index([slug])
  @@map("institutes")
}

model InstituteInvitation {
  id         String    @id @default(cuid())
  email      String
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?

  createdAt   DateTime   @default(now())
  institute   Institute? @relation(fields: [instituteId], references: [id])
  instituteId String?

  @@index([token])
  @@map("institute_invitations")
}

// =====================================================
// MODELOS DE USUARIOS Y AUTENTICACIÓN
// =====================================================

model User {
  id        String    @id // Cédula de identidad (CI) - definida por administrador
  email     String    @unique
  password  String
  firstName String
  lastName  String
  phone     String?
  birthDate DateTime?
  address   String?
  gender    Gender?
  avatar    String?

  // Lo que piden los documentos del Ministerio (Resumen Final, certificación).
  nacionalidad        String? // 'V' | 'E'
  lugarDeNacimiento   String?
  entidadDeNacimiento String? // una de ENTIDADES_DE_NACIMIENTO
  tipoDeCedula        String? // 'IDENTIDAD' | 'ESCOLAR'
  cedulaEscolar       String? // la escolar de antes, si la cambió por la de identidad
  role                UserRole
  isActive            Boolean   @default(true)
  status              String    @default("ACTIVE") // ACTIVE, ARCHIVED, DELETED
  archivedAt          DateTime?
  joinDate            DateTime  @default(now())
  lastLogin           DateTime?

  // Campos específicos para profesores
  specialization String?

  // Campos específicos para estudiantes
  studentCode String?

  // Relación con instituto
  // Configuraciones del usuario
  preferences Json?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones específicas por rol
  // Como Profesor
  teacherClassrooms      TeacherClassroom[]
  createdActivities      Activity[]
  gradesGiven            Grade[]
  attendanceRecords      DailyAttendance[]
  classroomsAsTeacher    Classroom[]             @relation("ClassroomTeacher")
  subjectTeachings       ClassroomSubject[]      @relation("SubjectTeacher")
  subjectTeacherHistory  SubjectTeacherHistory[] @relation("SubjectTeacherHistory")
  schedules              Schedule[]              @relation("ScheduleTeacher")
  personalScheduleBlocks ScheduleBlock[]         @relation("ScheduleBlockTeacher")
  createdSchoolEvents    SchoolEvent[]           @relation("CreatedSchoolEvents")
  replacementsTaught     ClassReplacement[]      @relation("ReplacementTeacher")
  photo                  UserPhoto?
  paymentPlans           StudentPaymentPlan[]
  payments               Payment[]               @relation("PaymentStudent")
  fichaDePersonal        Personal?               @relation("PersonalConCuenta")

  // Como Estudiante
  studentClassrooms   StudentClassroom[]
  grades              Grade[]            @relation("StudentGrades")
  attendance          DailyAttendance[]  @relation("StudentAttendance")
  academicHistory     AcademicRecord[]
  studentTutorings    StudentTutor[]     @relation("StudentTutorStudent")
  observations        Observation[]
  createdObservations Observation[]      @relation("CreatedObservations")

  // Como Tutor
  children StudentTutor[] @relation("StudentTutorTutor")

  // Auditoría
  auditLogs AuditLog[]

  // Sesiones y tokens
  refreshTokens           RefreshToken[]
  llavesDeTelefono        DeviceKey[]
  // Asistencia por QR
  pasesDeListaAbiertos    PaseDeLista[]            @relation("PaseAbiertoPor")
  registrosDeAsistenciaQr RegistroDeAsistenciaQr[] @relation("RegistroQrAlumno")
  notasDeRevision         NotaDeRevision[]         @relation("RevisionAlumno")
  apreciaciones           Apreciacion[]            @relation("ApreciacionAlumno")
  apreciacionesPuestas    Apreciacion[]            @relation("ApreciacionPuestaPor")
  decisionesDeFinDeAno    DecisionDeFinDeAno[]     @relation("DecisionFinDeAnoAlumno")
  materiasPendientes      MateriaPendiente[]       @relation("PendienteAlumno")
  pendientesQueEvalua     MateriaPendiente[]       @relation("PendienteProfesor")
  evaluacionesDePendiente EvaluacionDePendiente[]  @relation("EvaluacionPendientePuestaPor")
  laborSocial             ActividadDeLaborSocial[] @relation("LaborSocialAlumno")
  laborSocialAnotada      ActividadDeLaborSocial[] @relation("LaborSocialPuestaPor")
  calificacionesExternas  CalificacionExterna[]    @relation("CalificacionExternaAlumno")
  recaudosEntregados      RecaudoEntregado[]       @relation("RecaudoAlumno")
  suscripcionesDeAviso    SuscripcionDeAviso[]     @relation("SuscripcionesDeAviso")
  citaciones              Citacion[]               @relation("CitacionAlumno")
  notasDeOtroPlantel      NotaDeOtroPlantel[]      @relation("NotaDeOtroPlantelAlumno")
  titulos                 Titulo[]                 @relation("TituloAlumno")
  casosDelConsejo         CasoDelConsejo[]         @relation("CasoDelConsejoAlumno")
  aparatoDeAsistencia     AparatoDelAlumno?

  // Notificaciones
  notifications Notification[]
  institute     Institute?     @relation(fields: [instituteId], references: [id])
  instituteId   String?

  // Índices
  @@index([email])
  @@index([role])
  @@index([isActive])
  @@index([studentCode])
  @@index([role, isActive])
  // Buscar y ordenar la lista de usuarios sin recorrer la tabla entera
  // (migración 20260923120000_busqueda_de_usuarios). Medido con 15.000
  // personas: buscar 14 ms → 0,1 ms; ordenar una página 16 ms → 0,5 ms.
  @@index([role, lastName, firstName], map: "users_role_lastName_firstName_idx")
  @@index([firstName(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_firstName_trgm_idx")
  @@index([lastName(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_lastName_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_email_trgm_idx")
  @@index([studentCode(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_studentCode_trgm_idx")
  @@index([id(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_id_trgm_idx")
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Datos de sesión de dispositivo
  userAgent  String?
  ip         String? // IP con la que se creó la sesión
  lastUsedAt DateTime  @default(now()) // último uso actualizado en cada refresh
  rememberMe Boolean   @default(false) // sliding expiration activa
  /// Cuándo se cambió por uno nuevo. Sigue valiendo unos segundos más: dos
  /// pestañas que renuevan a la vez mandan el mismo token y una se quedaría
  /// fuera. Ver `GRACIA_DE_ROTACION_MS` en auth.service.ts.
  replacedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// LA LLAVE QUE GUARDA UN TELÉFONO PARA VOLVER A ENTRAR
///
/// No sirve para entrar por primera vez: se crea DESPUÉS de una entrada con
/// correo y contraseña, en ese teléfono y solo si su dueño lo pide. Lo que
/// hace la huella es abrir el cajón donde el teléfono la guardó (el almacén de
/// claves de Android, respaldado por hardware); la huella no viaja a ningún
/// sitio ni se guarda aquí.
///
/// Tres cosas la hacen segura, y las tres importan:
///   · aquí se guarda **solo el resumen** (SHA-256). Quien se lleve la base de
///     datos no se lleva ninguna llave;
///   · **se cambia en cada uso**, como la de volver a entrar: una copia robada
///     deja de valer en cuanto su dueño abre la app;
///   · caduca sola, y al cerrar sesión se anula.
model DeviceKey {
  id        String @id @default(cuid())
  /// SHA-256 de la llave. La llave en claro solo existe en el teléfono.
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// «Android · Chrome», para que se reconozca en la lista de sesiones.
  label String?

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
  @@index([expiresAt])
  @@map("device_keys")
}

// =====================================================
// MODELOS ACADÉMICOS
// =====================================================

model AcademicYear {
  id        String             @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean            @default(false)
  status    AcademicYearStatus @default(UPCOMING)

  // Instituto
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  periods               Period[]
  classrooms            Classroom[]
  academicRecords       AcademicRecord[]
  enrollments           StudentClassroom[]
  subjectResources      SubjectResource[]
  paymentPlans          StudentPaymentPlan[]
  ajustesDePagos        AjustesDePagosDelCiclo?
  ajustesDeNomina       AjustesDeNomina?
  acuerdosDePago        AcuerdoDePago[]
  pagosAlPersonal       PagoAlPersonal[]
  payments              Payment[]
  schoolEvents          SchoolEvent[]
  notasDeRevision       NotaDeRevision[]
  apreciaciones         Apreciacion[]
  decisionesDeFinDeAno  DecisionDeFinDeAno[]
  pendientesQueNacieron MateriaPendiente[]       @relation("PendienteOrigen")
  pendientesQueSeCursan MateriaPendiente[]       @relation("PendienteCiclo")
  laborSocial           ActividadDeLaborSocial[]
  titulos               Titulo[]
  institute             Institute?               @relation(fields: [instituteId], references: [id])
  instituteId           String?

  @@unique([name])
  @@map("academic_years")
}

model Period {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)

  /// Cuándo empieza el contenido del plan de evaluación en este lapso. Antes,
  /// semanas de diagnóstico o adaptación con contenido del profesor. Vacía =
  /// empieza con el lapso. La Semana 1 del plan es la que contiene esta fecha.
  inicioDelPlan      DateTime?
  /// Cómo se llaman esas semanas de antes en el liceo («Diagnóstico» si no dice).
  nombreAntesDelPlan String?

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  grades             Grade[]
  activities         Activity[]
  apreciaciones      Apreciacion[]
  notasDeOtroPlantel NotaDeOtroPlantel[]
  consejos           ConsejoDeSeccion[]

  @@unique([academicYearId, name])
  @@map("periods")
}

model Subject {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  code        String?
  description String?
  color       String?
  /// Con nota (01 a 20) o con apreciación; la eligen en el liceo.
  evaluacion  EvaluacionDeMateria @default(NUMERICA)

  // Instituto
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  apreciaciones      Apreciacion[]
  materiasPendientes MateriaPendiente[]
  classroomSubjects  ClassroomSubject[]
  activities         Activity[]
  grades             Grade[]
  schedules          Schedule[]
  classSessions      ClassSession[]
  pasesDeLista       PaseDeLista[]
  classActivities    ClassActivity[]
  resources          SubjectResource[]
  evaluationPlanRows EvaluationPlanRow[]
  replacedIn         ClassReplacement[]  @relation("ReplacementSuspendedSubject")
  replacingIn        ClassReplacement[]  @relation("ReplacementSubject")
  observations       Observation[]
  notasDeRevision    NotaDeRevision[]
  notasDeOtroPlantel NotaDeOtroPlantel[]
  institute          Institute?          @relation(fields: [instituteId], references: [id])
  instituteId        String?

  @@unique([name])
  @@map("subjects")
}

model SubjectResource {
  id   String @id @default(cuid())
  name String
  url  String
  type String @default("SYLLABUS")

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([subjectId, academicYearId])
  @@map("subject_resources")
}

model Classroom {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  section     String
  grade       Int
  capacity    Int?
  shift       String  @default("MANANA") // "MANANA" | "TARDE" | "INTEGRAL"
  isActive    Boolean @default(true)

  // Instituto
  // Profesor principal asignado
  teacherId String?
  teacher   User?   @relation("ClassroomTeacher", fields: [teacherId], references: [id], onDelete: SetNull)

  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  teachers           TeacherClassroom[]
  studentClassrooms  StudentClassroom[]
  subjects           ClassroomSubject[]
  activities         Activity[]
  schedules          Schedule[]
  attendanceRecords  DailyAttendance[]
  scheduleBlocks     ScheduleBlock[]     @relation("ClassroomScheduleBlocks")
  classSessions      ClassSession[]
  pasesDeLista       PaseDeLista[]
  classActivities    ClassActivity[]
  evaluationPlanRows EvaluationPlanRow[]
  replacements       ClassReplacement[]
  observations       Observation[]
  apreciaciones      Apreciacion[]
  consejos           ConsejoDeSeccion[]
  institute          Institute?          @relation(fields: [instituteId], references: [id])
  instituteId        String?

  @@unique([academicYearId, name, section])
  @@index([academicYearId])
  @@index([teacherId])
  @@index([grade])
  @@index([shift])
  @@map("classrooms")
}

// =====================================================
// MODELOS DE RELACIONES MANY-TO-MANY
// =====================================================

model TeacherClassroom {
  id String @id @default(cuid())

  teacherId String
  teacher   User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  isMainTeacher Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teacherId, classroomId])
  @@index([teacherId])
  @@index([classroomId])
  @@map("teacher_classrooms")
}

model StudentClassroom {
  id String @id @default(cuid())

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  enrollmentDate  DateTime  @default(now())
  isActive        Boolean   @default(true)
  /// El día en que se retiró del liceo (traslado u otro motivo) y por qué.
  /// Lo cuenta la estadística de matrícula. Ver `services/traslado.service.ts`.
  retiradoEl      DateTime? @db.Date
  motivoDeRetiro  String?
  /// El plantel del que venía, si llegó trasladado (archivo de traslado).
  plantelDeOrigen String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, academicYearId])
  @@index([studentId, isActive])
  @@index([academicYearId, isActive])
  @@index([classroomId, academicYearId, isActive])
  @@map("student_classrooms")
}

model ClassroomSubject {
  id String @id @default(cuid())

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  teacherId String?
  teacher   User?   @relation("SubjectTeacher", fields: [teacherId], references: [id], onDelete: SetNull)

  weeklyBlocks Int   @default(0)
  hoursPerWeek Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacherHistory SubjectTeacherHistory[]
  scheduleBlocks ScheduleBlock[]

  @@unique([classroomId, subjectId])
  @@index([teacherId])
  @@index([subjectId])
  @@map("classroom_subjects")
}

model SubjectTeacherHistory {
  id String @id @default(cuid())

  classroomSubjectId String
  classroomSubject   ClassroomSubject @relation(fields: [classroomSubjectId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   User   @relation("SubjectTeacherHistory", fields: [teacherId], references: [id], onDelete: Cascade)

  startDate DateTime  @default(now())
  endDate   DateTime?
  isActive  Boolean   @default(true)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classroomSubjectId, isActive])
  @@map("subject_teacher_history")
}

/// Un bloque de la cuadrícula del horario. Dos formas, una sola tabla —
/// `blockType` discrimina:
///
///   CLASS    → una clase. Cuelga de `classroomSubject` (sección + materia +
///              profesor), que es la asignación que hace el admin. Por eso el
///              horario de la sección y el del profesor son la misma tabla
///              vista desde dos lados.
///   PERSONAL → hora propia del profesor (planificación, guardia…). No tiene
///              sección ni materia: la crea el admin desde el horario del
///              profesor, con `title` y `notes`, y pertenece a `teacher`.
///
/// Viven juntos a propósito: la pregunta "¿está ocupada esta hora de este
/// profesor?" tiene que responderse con UNA consulta. Si estuvieran en tablas
/// distintas, cada camino que valida horarios tendría que acordarse de mirar
/// las dos, y olvidarlo fallaría en silencio (colocar una clase encima de la
/// hora personal de alguien).
model ScheduleBlock {
  id String @id @default(cuid())

  /// Nulo en los bloques PERSONAL: no pertenecen a ninguna sección.
  classroomId String?
  classroom   Classroom? @relation("ClassroomScheduleBlocks", fields: [classroomId], references: [id], onDelete: Cascade)

  classroomSubjectId String?
  classroomSubject   ClassroomSubject? @relation(fields: [classroomSubjectId], references: [id], onDelete: SetNull)

  /// Dueño del bloque PERSONAL. En los CLASS el profesor se obtiene a través
  /// de `classroomSubject.teacherId`, no aquí.
  teacherId String?
  teacher   User?   @relation("ScheduleBlockTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  dayOfWeek Int
  startTime String
  endTime   String
  blockType String  @default("CLASS")
  /// Solo en los PERSONAL: el título que le pone el admin.
  title     String?
  location  String?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classroomId, dayOfWeek])
  @@index([classroomSubjectId])
  @@index([classroomId, dayOfWeek, startTime])
  @@index([teacherId, dayOfWeek])
  @@map("schedule_blocks")
}

model StudentTutor {
  id String @id @default(cuid())

  studentId String
  student   User   @relation("StudentTutorStudent", fields: [studentId], references: [id], onDelete: Cascade)

  tutorId String
  tutor   User   @relation("StudentTutorTutor", fields: [tutorId], references: [id], onDelete: Cascade)

  relationship String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, tutorId])
  @@index([tutorId])
  @@map("student_tutors")
}

// =====================================================
// MODELOS DE ACTIVIDADES Y CALENDARIO
// =====================================================

model Activity {
  id          String  @id @default(cuid())
  title       String
  name        String?
  description String?
  type        String
  scope       String

  startDate DateTime
  endDate   DateTime?
  dueDate   DateTime?

  maxGrade  Float   @default(20)
  weight    Float   @default(1)
  isActive  Boolean @default(true)
  isVisible Boolean @default(true)

  // Campos del Plan de Evaluación Venezolano
  temaGenerador  String?
  tejidoTematico String?
  referentes     String?
  tecnicas       String?
  instrumentos   String?
  criterios      String?
  lapso          String? @default("1")

  // Instituto
  // Relaciones académicas
  periodId    String?
  period      Period?    @relation(fields: [periodId], references: [id], onDelete: SetNull)
  subjectId   String?
  subject     Subject?   @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  classroomId String?
  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)

  createdBy String
  creator   User   @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grades      Grade[]
  planRow     EvaluationPlanRow?
  institute   Institute?         @relation(fields: [instituteId], references: [id])
  instituteId String?

  orderIndex Int @default(0)

  @@index([classroomId])
  @@index([subjectId])
  @@index([periodId])
  @@index([createdBy])
  @@index([startDate])
  @@index([classroomId, periodId])
  @@index([subjectId, periodId])
  @@index([isActive, dueDate])
  @@map("activities")
}

model EvaluationPlanMetadata {
  id          String @id @default(cuid())
  classroomId String
  subjectId   String
  lapso       String

  // Membrete (auto-llenado, editable)
  nombreDocente   String?
  cedulaDocente   String?
  telefonoDocente String?
  correoDocente   String?
  areaFormacion   String?
  annoSeccion     String?
  periodoEscolar  String?
  totalSemanas    Int?
  fechaDesde      DateTime?
  fechaHasta      DateTime?

  // Campos del plan
  peic              String?
  enfasisCurricular String?
  referentesEticos  String?
  intencionalidad   String?
  temaIndispensable String?

  // Observaciones y firmas
  observaciones String?

  // Nombres de columnas personalizadas (JSON o texto plano separado por comas)
  customColumns String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classroomId, subjectId, lapso])
  @@map("evaluation_plan_metadata")
}

model EvaluationPlanRow {
  id String @id @default(cuid())

  // Identificación del plan
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lapso       String

  // Estructura
  rowType       String // "HEADER" | "FIELD" | "EVALUATION" | "TEXT" | "INDICATORS"
  weekNumber    Int
  endWeekNumber Int? // Para permitir que una fila abarque desde weekNumber hasta endWeekNumber
  orderIndex    Int    @default(0)

  // HEADER fields
  title        String?
  headingLevel Int? // 1, 2, 3

  // FIELD fields
  label   String?
  content String?

  // TEXT fields
  textContent String?

  // EVALUATION fields (campos fijos)
  actividadEval  String?
  tecnicas       String?
  instrumentos   String?
  criterios      String?
  ponderacion    Float? // % del total
  puntos         Float? // Puntos
  tipoEvaluacion String? // "FORMATIVA" | "SUMATIVA" | "DIAGNOSTICA"

  // INDICATORS fields (JSON desglose)
  indicadores String? // JSON: {"SER": 1, "HACER": 2, ...}

  // Datos extra para columnas personalizadas (JSON)
  extraData String?

  // Actividades de Clase en Vivo vinculadas a este criterio/bloque
  classActivities ClassActivity[]

  /// El instrumento con que se califica esta evaluación (lista de cotejo,
  /// escala de estimación, rúbrica…). Ver `utils/instrumentos.ts`.
  instrumento InstrumentoDeEvaluacion?

  // Link a Activity para calificaciones
  activityId String?   @unique
  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classroomId, subjectId, lapso])
  @@index([classroomId, subjectId, lapso, weekNumber])
  @@map("evaluation_plan_rows")
}

// =====================================================
// MODELOS DE CALIFICACIONES
// =====================================================

model Grade {
  id       String  @id @default(cuid())
  score    Float? // Opcional para actividades consolidadas
  scores   Json? // Para múltiples actividades consolidadas
  comments String?
  metadata Json? // feedback largo, attachments, historial

  studentId  String
  student    User     @relation("StudentGrades", fields: [studentId], references: [id], onDelete: Cascade)
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  periodId   String
  period     Period   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId  String
  teacher    User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, activityId])
  @@index([studentId, subjectId, periodId])
  @@index([subjectId, periodId])
  @@index([activityId])
  @@index([teacherId])
  @@index([teacherId, createdAt(sort: Desc)])
  @@map("grades")
}

// =====================================================
// MODELOS DE ASISTENCIA
// =====================================================

model DailyAttendance {
  id      String           @id @default(cuid())
  date    DateTime         @db.Date // Solo fecha, sin hora
  status  AttendanceStatus @default(PRESENT)
  periods Int              @default(0) // Bitfield para 8 períodos (0-255)

  // Campos opcionales para detalles
  lateArrival Int? // Minutos de retraso
  earlyLeave  Int? // Minutos de salida temprana
  excuseNote  String? // Nota de justificación
  comments    String?

  studentId   String
  student     User      @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     User      @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  classSessionId String?
  classSession   ClassSession? @relation(fields: [classSessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Quién la cambió por última vez (la crea `teacherId`).
  modificadoPorId String?

  @@unique([studentId, date])
  @@index([studentId, classroomId])
  @@index([classroomId, date])
  @@index([studentId, date(sort: Desc)])
  @@index([teacherId])
  @@index([classSessionId])
  @@map("daily_attendance")
}

// =====================================================
// MODELOS DE HORARIOS
// =====================================================

model Schedule {
  id        String  @id @default(cuid())
  dayOfWeek String
  startTime String
  endTime   String
  room      String?
  notes     String?

  // Instituto
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     User      @relation("ScheduleTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  institute   Institute? @relation(fields: [instituteId], references: [id])
  instituteId String?

  @@unique([classroomId, subjectId, dayOfWeek, startTime])
  @@map("schedules")
}

// =====================================================
// MODELOS DE AUDITORÍA Y LOGS
// =====================================================

model AuditLog {
  id         String  @id @default(cuid())
  action     String
  entity     String
  entityType String
  entityId   String
  oldValues  Json?
  newValues  Json?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  level      String  @default("NORMAL") // CRITICAL, SECURITY, NORMAL

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Instituto (FK real)
  createdAt   DateTime   @default(now())
  institute   Institute? @relation(fields: [instituteId], references: [id])
  instituteId String?

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([level, createdAt(sort: Desc)])
  @@index([entityType, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// =====================================================
// MODELOS DE NOTIFICACIONES
// =====================================================

model Notification {
  id       String @id @default(cuid())
  title    String
  message  String
  type     String
  priority String

  recipientId String
  recipient   User   @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  senderId  String?
  data      Json?
  actionUrl String?
  readAt    DateTime?
  emailSent Boolean   @default(false)

  // TTL para limpieza automática
  expiresAt  DateTime? // Null = sin expiración
  persistent Boolean   @default(false) // true = nunca expira

  // Instituto
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  institute   Institute? @relation(fields: [instituteId], references: [id])
  instituteId String?

  @@index([recipientId, readAt])
  @@index([type])
  @@index([createdAt(sort: Desc)])
  @@index([recipientId, createdAt(sort: Desc)])
  @@map("notifications")
}

// =====================================================
// MODELOS DE DASHBOARD DE ESTUDIANTE
// =====================================================

model Observation {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String   @default("OBSERVACION")
  date        DateTime @default(now())

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("CreatedObservations", fields: [createdById], references: [id], onDelete: Cascade)

  classroomId String?
  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  classSessionId String?
  classSession   ClassSession? @relation(fields: [classSessionId], references: [id], onDelete: SetNull)

  groupId String?

  citaciones Citacion[]

  // Instituto
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  institute   Institute? @relation(fields: [instituteId], references: [id])
  instituteId String?

  @@index([studentId])
  @@index([createdById])
  @@index([classroomId])
  @@index([subjectId])
  @@index([classSessionId])
  @@index([groupId])
  @@index([date])
  @@map("observations")
}

model AcademicRecord {
  id        String @id @default(cuid())
  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  sectionSnapshot String
  finalAverage    Float
  status          String

  // Fase 3.5-C — cierre de ciclo:
  //  - finalResult: PROMOVIDO | PROMOVIDO_CON_PENDIENTES | NO_PROMOVIDO (lo que
  //    dejó el admin tras la revisión, no la sugerencia automática)
  //  - pendingSubjects: materias pendientes (JSON array)
  //  - subjectGrades: desglose de promedio final por materia (JSON)
  //  - assignedClassroomId: sección asignada en el año siguiente (si aplica)
  finalResult         String?
  pendingSubjects     Json?
  subjectGrades       Json?
  assignedClassroomId String?

  /// Lo que sugería el sistema con las reglas del liceo (para ver qué cambió el admin).
  condicionSugerida String?
  /// Por qué el admin decidió distinto de la sugerencia, o por qué lo corrigió después.
  motivo            String?
  decididaPor       String?
  corregidoEl       DateTime?
  /// Solo en el último año: EGRESADO, o PENDIENTE (le faltan materias o la labor social).
  egreso            String?

  createdAt DateTime @default(now())

  @@unique([studentId, academicYearId])
  @@map("academic_records")
}

/// LA REVISIÓN DE UNA MATERIA REPROBADA
///
/// Al terminar el tercer lapso, el alumno que reprobó una materia la presenta
/// en revisión; esa nota es su definitiva para la promoción. Se registra ANTES
/// de cerrar el ciclo y el cierre la usa. Ver `services/revision.service.ts`.
model NotaDeRevision {
  id String @id @default(cuid())

  studentId String
  student   User   @relation("RevisionAlumno", fields: [studentId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  score         Float
  fecha         DateTime @db.Date
  registradaPor String
  observaciones String?
  /// Las partes de la revisión con su peso y su nota, si el liceo la divide
  /// (p. ej. 30 % actividades + 70 % prueba): [{ nombre, peso, nota }].
  componentes   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, subjectId, academicYearId])
  @@index([academicYearId])
  @@map("notas_de_revision")
}

/// Lo que decide el admin para un alumno al cerrar el año, cuando no es lo que
/// sugiere el sistema: con su motivo, que queda anotado. Sin fila, manda la
/// sugerencia. Ver `services/fin-de-ano.service.ts`.
model DecisionDeFinDeAno {
  id String @id @default(cuid())

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("DecisionFinDeAnoAlumno", fields: [studentId], references: [id], onDelete: Cascade)

  /// PROMOVIDO | PROMOVIDO_CON_PENDIENTES | NO_PROMOVIDO
  condicion   String
  motivo      String
  decididaPor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academicYearId, studentId])
  @@map("decisiones_de_fin_de_ano")
}

/// LA MATERIA PENDIENTE: la que el alumno reprobó y arrastra al año siguiente.
/// La evalúa un profesor en varios momentos (`EvaluacionDePendiente`); el
/// cierre de ese año la tiene en cuenta. Ver `services/materias-pendientes.service.ts`.
model MateriaPendiente {
  id String @id @default(cuid())

  studentId String
  student   User   @relation("PendienteAlumno", fields: [studentId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  /// El año (grado) en que la reprobó y el año escolar.
  gradoDeOrigen   Int
  cicloDeOrigenId String
  cicloDeOrigen   AcademicYear @relation("PendienteOrigen", fields: [cicloDeOrigenId], references: [id], onDelete: Cascade)
  /// La definitiva con que la reprobó (o la de la revisión).
  notaDeOrigen    Float?

  /// El año escolar en que se cursa.
  cicloId String
  ciclo   AcademicYear @relation("PendienteCiclo", fields: [cicloId], references: [id], onDelete: Cascade)

  /// Quién la evalúa: por defecto el que da esa materia en ese grado este año.
  profesorId String?
  profesor   User?   @relation("PendienteProfesor", fields: [profesorId], references: [id], onDelete: SetNull)

  /// PENDIENTE | APROBADA | NO_APROBADA
  estado    String @default("PENDIENTE")
  notaFinal Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evaluaciones EvaluacionDePendiente[]

  @@unique([studentId, subjectId, cicloDeOrigenId, cicloId])
  @@index([cicloId])
  @@index([profesorId])
  @@map("materias_pendientes")
}

/// Cada momento en que se evalúa una materia pendiente (4 por defecto).
model EvaluacionDePendiente {
  id String @id @default(cuid())

  materiaPendienteId String
  materiaPendiente   MateriaPendiente @relation(fields: [materiaPendienteId], references: [id], onDelete: Cascade)

  momento       Int
  nota          Float
  fecha         DateTime @db.Date
  observaciones String?

  registradaPorId String?
  registradaPor   User?   @relation("EvaluacionPendientePuestaPor", fields: [registradaPorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([materiaPendienteId, momento])
  @@map("evaluaciones_de_pendientes")
}

/// LA LABOR SOCIAL (las horas comunitarias de los últimos años): cada alumno
/// hace actividades distintas, en sitios distintos y de horas distintas. La
/// anotan el admin y el profesor guía de su sección. Ver
/// `services/labor-social.service.ts`.
model ActividadDeLaborSocial {
  id String @id @default(cuid())

  studentId String
  student   User   @relation("LaborSocialAlumno", fields: [studentId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  fecha             DateTime @db.Date
  horas             Float
  /// Qué hizo, dónde, en qué proyecto y quién lo supervisó en la comunidad.
  que               String
  donde             String?
  proyecto          String?
  responsable       String?
  observaciones     String?
  /// Con esta actividad culmina su proyecto (para el liceo que la mide por proyecto).
  culminaElProyecto Boolean  @default(false)
  /// Las que se anotaron juntas (una salida de toda la sección) llevan el mismo.
  grupo             String?

  registradaPorId String?
  registradaPor   User?   @relation("LaborSocialPuestaPor", fields: [registradaPorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([academicYearId])
  @@map("actividades_de_labor_social")
}

/// Las notas de los años que el alumno cursó en OTRO plantel, para su
/// certificación de calificaciones (las del liceo salen de sus expedientes).
/// Las carga el admin desde la certificación del alumno.
model CalificacionExterna {
  id String @id @default(cuid())

  studentId String
  student   User   @relation("CalificacionExternaAlumno", fields: [studentId], references: [id], onDelete: Cascade)

  grado            Int
  anoEscolar       String
  materia          String
  nota             Float?
  /// Si la materia se evalúa con apreciación, en lugar de la nota.
  apreciacion      String?
  /// F (final), R (revisión) o MP (materia pendiente)
  tipo             String  @default("F")
  /// Mes y año en que se aprobó (p. ej. «07/2024»), como pide la certificación.
  fecha            String?
  plantel          String
  codigoDelPlantel String?
  entidad          String?

  registradaPor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@map("calificaciones_externas")
}

/// El acta del consejo de sección de un lapso: cuándo fue, qué profesores
/// asistieron, los casos de alumnos tratados y los acuerdos. La escriben el
/// admin y el profesor guía; la leen los profesores de la sección. Una por
/// sección y lapso. Ver `services/consejo.service.ts`.
model ConsejoDeSeccion {
  id String @id @default(cuid())

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  periodId String
  period   Period @relation(fields: [periodId], references: [id], onDelete: Cascade)

  fecha             DateTime @db.Date
  /// [{ id, nombre, materias, asistio }]: los profesores de la sección.
  asistentes        Json
  acuerdosGenerales String?
  escritoPor        String?

  casos CasoDelConsejo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classroomId, periodId])
  @@map("consejos_de_seccion")
}

/// Un alumno tratado en el consejo: por qué (lo que propuso el sistema o se
/// añadió a mano), lo que se trató y el acuerdo.
model CasoDelConsejo {
  id String @id @default(cuid())

  consejoId String
  consejo   ConsejoDeSeccion @relation(fields: [consejoId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("CasoDelConsejoAlumno", fields: [studentId], references: [id], onDelete: Cascade)

  /// Lo que lo trae al consejo: materias reprobadas, asistencia, observaciones.
  motivos   Json?
  loTratado String?
  acuerdo   String?
  orden     Int     @default(0)

  @@unique([consejoId, studentId])
  @@map("casos_del_consejo")
}

/// El título de bachiller de un egresado: la mención, el número (serial) del
/// título y cuándo se expidió. Lo anota el admin en «Graduandos» del ciclo,
/// solo para quien egresó al cerrar el año. Ver `services/graduandos.service.ts`.
model Titulo {
  id String @id @default(cuid())

  studentId String
  student   User   @relation("TituloAlumno", fields: [studentId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  mencion           String
  serial            String?   @unique
  fechaDeExpedicion DateTime? @db.Date
  registradoPor     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, academicYearId])
  @@map("titulos")
}

/// La nota de un lapso que el alumno cursó en OTRO liceo este mismo año,
/// traída con su archivo de traslado. Cuenta en el promedio de ese lapso
/// (nivel 2) solo si el alumno no tiene notas propias en él.
/// Ver `services/traslado.service.ts` y MAPA_DE_CALCULOS.md §1.
model NotaDeOtroPlantel {
  id String @id @default(cuid())

  studentId String
  student   User   @relation("NotaDeOtroPlantelAlumno", fields: [studentId], references: [id], onDelete: Cascade)

  periodId String
  period   Period @relation(fields: [periodId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  nota             Float
  /// Cómo se llamaba la materia allá y en qué plantel.
  materiaDeOrigen  String
  plantel          String
  codigoDelPlantel String?

  createdAt DateTime @default(now())

  @@unique([studentId, periodId, subjectId])
  @@index([studentId])
  @@map("notas_de_otro_plantel")
}

/// Citar al representante desde una observación: cuándo, dónde y para qué,
/// y después si vino y lo que se habló. Al crearla se le avisa (campana y
/// teléfono). La ponen el admin, el profesor guía de la sección del alumno y
/// quien escribió la observación. Ver `services/citaciones.service.ts`.
model Citacion {
  id String @id @default(cuid())

  observationId String
  observation   Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("CitacionAlumno", fields: [studentId], references: [id], onDelete: Cascade)

  /// El día y la hora (hora del liceo, guardada como texto «08:00»).
  fecha        DateTime @db.Date
  hora         String
  lugar        String
  motivo       String
  /// PENDIENTE | ASISTIO | NO_ASISTIO
  estado       String   @default("PENDIENTE")
  /// Lo que se habló en la reunión (o por qué no vino).
  loQueSeHablo String?

  citadaPor  String
  marcadaPor String?
  marcadaEl  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([observationId])
  @@index([fecha])
  @@map("citaciones")
}

/// Un teléfono (o navegador) que recibe avisos de esta persona con la app
/// cerrada: Web Push (la PWA) o Firebase (la APK). Se borra al cerrar sesión
/// en ese teléfono y cuando el servicio dice que ya no existe (404/410).
/// Ver `services/avisos.service.ts`.
model SuscripcionDeAviso {
  id String @id @default(cuid())

  userId String
  user   User   @relation("SuscripcionesDeAviso", fields: [userId], references: [id], onDelete: Cascade)

  /// WEB | FCM
  tipo      String
  /// La dirección de Web Push o el token de Firebase.
  destino   String   @unique
  /// Web Push: las llaves del navegador (p256dh, auth).
  llaves    Json?
  aparato   String?
  createdAt DateTime @default(now())
  ultimaVez DateTime @default(now())

  @@index([userId])
  @@map("suscripciones_de_aviso")
}

/// Lo que el alumno ya entregó para su inscripción (partida de nacimiento,
/// fotos…). La lista de lo que se pide es de cada liceo
/// (`academicConfig.inscripcion.recaudos`); aquí solo lo entregado. Lo marca
/// el admin en la ficha, cuando llega: no hace falta al crear la cuenta.
/// Ver `services/inscripcion.service.ts`.
model RecaudoEntregado {
  id String @id @default(cuid())

  studentId String
  student   User   @relation("RecaudoAlumno", fields: [studentId], references: [id], onDelete: Cascade)

  /// La clave del recaudo en la lista del liceo.
  recaudo     String
  entregadoEl DateTime @default(now())
  anotadoPor  String?

  createdAt DateTime @default(now())

  @@unique([studentId, recaudo])
  @@map("recaudos_entregados")
}

/// La apreciación de un alumno en una materia cualitativa: por lapso o la
/// final del año (`momento` = id del lapso o «FINAL»). La pone el profesor
/// que da esa materia en esa sección. Ver `services/apreciaciones.service.ts`.
model Apreciacion {
  id String @id @default(cuid())

  studentId String
  student   User   @relation("ApreciacionAlumno", fields: [studentId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  /// El lapso, o vacío si es la apreciación final.
  periodId String?
  period   Period? @relation(fields: [periodId], references: [id], onDelete: Cascade)
  /// El id del lapso o «FINAL» (una clave única no puede apoyarse en un vacío).
  momento  String

  valor       String
  observacion String?

  registradaPorId String?
  registradaPor   User?   @relation("ApreciacionPuestaPor", fields: [registradaPorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, subjectId, academicYearId, momento])
  @@index([classroomId, subjectId])
  @@map("apreciaciones")
}

// =====================================================
// MODELOS DE MONITOREO Y PERFORMANCE
// =====================================================

model QueryMetric {
  id        String   @id @default(cuid())
  model     String
  operation String
  duration  Int
  timestamp DateTime @default(now())
  severity  String

  totalQueries     Int?
  averageDuration  Int?
  slowQueriesCount Int?

  createdAt DateTime @default(now())

  @@index([timestamp])
  @@index([severity])
  @@index([model, operation])
  @@map("query_metrics")
}

model SystemAlert {
  id         String    @id @default(cuid())
  type       String
  severity   String
  message    String
  data       Json?
  resolved   Boolean   @default(false)
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([type, resolved])
  @@index([createdAt])
  @@index([severity, resolved])
  @@map("system_alerts")
}

// =====================================================
// MODELOS DE CLASES (SESIONES)
// =====================================================

// =====================================================
// EVENTOS DEL LICEO (actos, jornadas, reuniones…)
// =====================================================

/// Un evento que crea el director/admin sobre una franja de un día concreto.
///
/// Siempre suspende las clases que caen en su franja y su alcance (decisión de
/// producto). La suspensión se hace marcando la `ClassSession` de ese día como
/// SUSPENDED — el mismo estado que usa Clase en Vivo, que ya muestra "Clase
/// suspendida: <motivo>" — y se registra en `suspendedByEventId` para poder
/// deshacerla si el evento se borra o se mueve.
///
/// Alcance (`scope`):
///   INSTITUTE  → todas las secciones del ciclo escolar
///   GRADES     → las secciones de los años listados en `grades` (1 = 1er año…)
///   CLASSROOMS → las secciones listadas en `classroomIds`
model SchoolEvent {
  id          String  @id @default(cuid())
  title       String
  description String?

  date      DateTime @db.Date
  /// Franja cubierta: del inicio del primer bloque al fin del último.
  startTime String
  endTime   String

  scope        String   @default("INSTITUTE")
  grades       Int[]    @default([])
  classroomIds String[] @default([])

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("CreatedSchoolEvents", fields: [createdById], references: [id], onDelete: SetNull)

  suspendedSessions ClassSession[] @relation("EventSuspendedSessions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([academicYearId, date])
  @@index([date])
  @@map("school_events")
}

model ClassSession {
  id                 String   @id @default(cuid())
  publicId           String   @unique @default(cuid())
  date               DateTime @db.Date
  startTime          String?
  endTime            String?
  topic              String?
  observations       String?
  observationsTitle  String?
  involvedStudentIds String[] @default([])

  // Estado de la clase: ACTIVE | SUSPENDED
  status          String  @default("ACTIVE")
  suspendedReason String?

  /// Evento del liceo que suspendió esta clase, si fue uno. Permite revertir la
  /// suspensión al borrar o mover el evento sin tocar las suspensiones que hizo
  /// un profesor a mano (esas tienen este campo nulo).
  suspendedByEventId String?
  suspendedByEvent   SchoolEvent? @relation("EventSuspendedSessions", fields: [suspendedByEventId], references: [id], onDelete: SetNull)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  attendanceRecords DailyAttendance[]
  activities        ClassActivity[]
  observationsList  Observation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classroomId, subjectId, date])
  @@index([classroomId, subjectId])
  @@index([suspendedByEventId])
  @@index([date])
  @@index([classroomId, date])
  @@index([subjectId, date])
  @@map("class_sessions")
}

// =====================================================
// ASISTENCIA POR QR (ver services/asistencia-qr.service.ts)
// =====================================================

/// UN PASE DE LISTA POR QR
///
/// Lo abre el profesor (o el admin) en una clase: su teléfono enseña un código
/// que cambia cada 10 s y los alumnos lo escanean desde su app. Es solo la
/// forma de IDENTIFICAR al alumno: lo que queda es la asistencia de siempre
/// (`daily_attendance`), la misma que marca el profesor a mano.
model PaseDeLista {
  id String @id @default(cuid())

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  /// El día de la clase. Si es anterior a hoy, el pase es una CORRECCIÓN.
  fecha       DateTime  @db.Date

  abiertoPorId String
  abiertoPor   User   @relation("PaseAbiertoPor", fields: [abiertoPorId], references: [id], onDelete: Cascade)

  abiertoEn    DateTime  @default(now())
  /// Quien escanea después de esto entra como TARDE.
  aTiempoHasta DateTime
  /// Cierre de seguridad: un pase olvidado abierto no sirve para siempre.
  caducaEn     DateTime
  cerradoEn    DateTime?
  esCorreccion Boolean   @default(false)

  /// Firma los códigos que rotan. No sale nunca del servidor.
  secreto String

  /// El faro: dónde estaba el teléfono del profesor al abrirlo.
  latitud   Float?
  longitud  Float?
  precision Float?

  registros RegistroDeAsistenciaQr[]

  @@index([classroomId, subjectId, fecha])
  @@index([abiertoPorId, cerradoEn])
  @@map("pases_de_lista")
}

/// CADA INTENTO DE UN ALUMNO, ACEPTADO O NO
///
/// Si mañana hay un reclamo, aquí está con qué teléfono, a qué hora, desde
/// dónde y por qué se aceptó o se rechazó.
model RegistroDeAsistenciaQr {
  id String @id @default(cuid())

  paseId String
  pase   PaseDeLista @relation(fields: [paseId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("RegistroQrAlumno", fields: [studentId], references: [id], onDelete: Cascade)

  /// ALUMNO_ESCANEA (el alumno escanea el QR del profesor) | PROFESOR_ESCANEA
  forma  String
  /// ACEPTADO | POR_CONFIRMAR | RECHAZADO | QUITADO
  estado String
  /// Por qué no se aceptó a la primera (OTRO_TELEFONO, FUERA_DEL_RADIO…).
  motivo String?

  /// Lo que se le puso: PRESENT o LATE.
  asistencia         String?
  /// Lo que tenía antes, para devolverlo si el profesor lo quita (corrección).
  asistenciaAnterior String?

  /// Resumen del identificador del aparato (nunca el identificador en claro).
  aparatoHash String?
  aparato     String?

  latitud        Float?
  longitud       Float?
  precision      Float?
  distancia      Float?
  ubicacionFalsa Boolean @default(false)

  creadoEn      DateTime  @default(now())
  resueltoPorId String?
  resueltoEn    DateTime?

  @@index([paseId])
  @@index([studentId])
  @@index([aparatoHash])
  @@map("registros_asistencia_qr")
}

/// EL TELÉFONO DE CADA ALUMNO PARA LA ASISTENCIA
///
/// Una cuenta, un teléfono. El primero desde el que un alumno pasa asistencia
/// queda suyo; un teléfono, de un alumno. Si lo cambia, el admin lo desbloquea
/// desde su perfil (y queda anotado en `audit_logs`).
model AparatoDelAlumno {
  studentId String @id
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  aparatoHash  String   @unique
  descripcion  String?
  registradoEn DateTime @default(now())
  ultimoUso    DateTime @default(now())

  @@map("aparatos_de_alumnos")
}

// =====================================================
// PAGOS (módulo que el liceo activa en Configuración)
// =====================================================

/// CONFIGURACIÓN DE PAGOS DEL LICEO
///
/// Una sola fila (`id = "liceo"`). Todo configurable: nada de montos, monedas
/// ni frecuencias fijas en el código. Las reglas de cálculo están en
/// `services/pagos.service.ts` y en docs/MAPA_DE_CALCULOS.md.
model PaymentSettings {
  id      String  @id @default("liceo")
  enabled Boolean @default(false)

  /// MONTHLY | BIWEEKLY | PER_PERIOD
  frequency String @default("MONTHLY")
  /// SAME_DAY (todos el mismo día) | PER_STUDENT (cada alumno su día)
  dueMode   String @default("SAME_DAY")
  /// Día del mes en que vence (1–28). En quincenal, vence este día y 15 días después.
  dueDay    Int    @default(5)
  graceDays Int    @default(0)

  /// Moneda en que se fijan los montos: USD | VES
  baseCurrency       String @default("USD")
  /// Monedas en que se aceptan los pagos: USD | VES | BOTH
  acceptedCurrencies String @default("BOTH")

  feeAmount Decimal @default(0) @db.Decimal(12, 2)

  enrollmentEnabled Boolean @default(false)
  enrollmentAmount  Decimal @default(0) @db.Decimal(12, 2)

  /// Métodos de pago que ofrece el liceo (lista de textos).
  methods Json @default("[\"Efectivo\", \"Pago Móvil\", \"Transferencia\", \"Zelle\"]")

  /// Las categorías con que se anotan los gastos (lista de textos, editable).
  categoriasDeGasto Json @default("[\"Mantenimiento\", \"Reparación\", \"Compras\", \"Servicios\", \"Otro\"]")

  /// Lo que lleva un ciclo nuevo (ver `AjustesDePagosDelCiclo`).
  descuentoHermanosPct  Int     @default(0)
  moraTipo              String  @default("NINGUNA")
  moraValor             Decimal @default(0) @db.Decimal(12, 2)
  moraDiasDespues       Int     @default(0)
  recordatorioDiasAntes Int     @default(3)

  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("payment_settings")
}

/// LA CONFIGURACIÓN DE PAGOS DE UN CICLO (2026-10-01)
///
/// `PaymentSettings` es una sola fila para todo el liceo. Con solo eso, subir la
/// cuota el año que viene recalculaba los ciclos pasados con la cuota nueva y
/// salían «debiendo». Cada ciclo guarda aquí SU configuración: la del liceo se
/// copia al primer pago del ciclo (o al guardar la configuración con él en
/// curso), y desde entonces ese ciclo no cambia aunque cambie la del liceo.
model AjustesDePagosDelCiclo {
  academicYearId String       @id
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  frequency          String  @default("MONTHLY")
  dueMode            String  @default("SAME_DAY")
  dueDay             Int     @default(5)
  graceDays          Int     @default(0)
  baseCurrency       String  @default("USD")
  acceptedCurrencies String  @default("BOTH")
  feeAmount          Decimal @default(0) @db.Decimal(12, 2)
  enrollmentEnabled  Boolean @default(false)
  enrollmentAmount   Decimal @default(0) @db.Decimal(12, 2)
  methods            Json    @default("[\"Efectivo\", \"Pago Móvil\", \"Transferencia\", \"Zelle\"]")

  /// Descuento automático desde el 2.º hijo del mismo representante (0–100).
  descuentoHermanosPct Int     @default(0)
  /// Recargo por cuota vencida: NINGUNA | FIJA | PORCENTAJE. Una vez por cuota.
  moraTipo             String  @default("NINGUNA")
  moraValor            Decimal @default(0) @db.Decimal(12, 2)
  /// Días después de la gracia en que se cobra el recargo.
  moraDiasDespues      Int     @default(0)
  /// Cuántos días antes del vencimiento se le recuerda al representante (0 = no).
  recordatorioDiasAntes Int    @default(3)

  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ajustes_de_pagos_del_ciclo")
}

/// Lo particular de un alumno en un ciclo: su día de pago (si cada uno tiene el
/// suyo) y si está exonerado o becado.
model StudentPaymentPlan {
  id String @id @default(cuid())

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  dueDay       Int?
  exempt       Boolean @default(false)
  exemptReason String?
  /// Beca o descuento propio (0–100 %), con su motivo (2026-10-01).
  descuentoPct    Int     @default(0)
  descuentoMotivo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, academicYearId])
  @@index([academicYearId])
  @@map("student_payment_plans")
}

/// UN PAGO RECIBIDO
///
/// No se borra nunca: un pago mal registrado se ANULA con motivo, y queda a la
/// vista quién lo registró y quién lo anuló.
model Payment {
  id            String @id @default(cuid())
  /// Número correlativo del comprobante dentro del liceo.
  receiptNumber Int    @unique @default(autoincrement())

  studentId String
  student   User   @relation("PaymentStudent", fields: [studentId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  paidAt    DateTime @db.Date
  method    String
  reference String?
  notes     String?

  /// Lo que entregó el representante, en su moneda.
  currency     String
  amount       Decimal  @db.Decimal(12, 2)
  /// Bolívares por dólar, cuando se paga en una moneda distinta a la base.
  exchangeRate Decimal? @db.Decimal(14, 4)
  /// El mismo monto llevado a la moneda base: es lo que se reparte en cuotas.
  amountBase   Decimal  @db.Decimal(12, 2)

  createdById String?

  annulledAt   DateTime?
  annulledById String?
  annulReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations PaymentAllocation[]

  @@index([studentId, academicYearId])
  @@index([academicYearId, annulledAt])
  @@map("payments")
}

/// Cuánto de un pago va a cada cuota. Permite abonos: una cuota puede tener
/// varios repartos que juntos la completan.
model PaymentAllocation {
  id String @id @default(cuid())

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  /// "INS", "2026-09", "2026-09-2" (2ª quincena), "P:<periodId>".
  installmentKey String
  amountBase     Decimal @db.Decimal(12, 2)

  @@index([paymentId])
  @@index([installmentKey])
  @@map("payment_allocations")
}

/// FOTO DE PERFIL
///
/// Se guarda en la base del liceo y no en una carpeta: viaja con el respaldo y
/// no hay forma de pedir la de otro liceo cambiando una dirección. Nunca es la
/// imagen que se subió: el servidor la redibuja a 256×256 en WebP (unos 15 KB),
/// lo que de paso tira los metadatos (la ubicación GPS de la foto del teléfono)
/// y cualquier cosa escondida dentro del archivo original.
model UserPhoto {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  data    Bytes
  /// Huella corta del contenido: cambia con cada foto, para que el navegador
  /// no enseñe la vieja guardada.
  version String
  size    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_photos")
}

/// REEMPLAZO DE UNA CLASE SUSPENDIDA
///
/// Cuando el admin suspende una clase puede poner OTRA materia de la misma
/// sección en ese hueco (un profesor faltó y otro adelanta su clase). Es una
/// fila por bloque del horario que se cubre, en una fecha concreta: el horario
/// semanal no cambia.
///
/// El profesor es el de la materia que entra (`classroomSubject.teacherId`)
/// copiado aquí, para que sus permisos de pasar asistencia y poner notas sean
/// los de siempre: da esa materia en esa sección.
///
/// La clase que se da es la sesión normal de esa materia ese día
/// (`ClassSession` es única por sección + materia + día).
model ClassReplacement {
  id String @id @default(cuid())

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  date      DateTime @db.Date
  startTime String
  endTime   String

  /// La materia suspendida cuyo hueco se cubre.
  suspendedSubjectId String
  suspendedSubject   Subject @relation("ReplacementSuspendedSubject", fields: [suspendedSubjectId], references: [id], onDelete: Cascade)

  /// La materia que entra en su lugar.
  subjectId String
  subject   Subject @relation("ReplacementSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   User   @relation("ReplacementTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  reason      String?
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classroomId, date, startTime])
  @@index([teacherId, date])
  @@index([classroomId, date])
  @@map("class_replacements")
}

// =====================================================
// ACTIVIDADES / TAREAS POR CLASE
// =====================================================

model ClassActivity {
  id                    String    @id @default(cuid())
  title                 String
  description           String?
  type                  String    @default("TAREA") // TAREA | EXAMEN | ACTIVIDAD
  target                String    @default("NEXT") // CURRENT (esta clase) | NEXT (próxima clase)
  tag                   String? // Etiqueta personalizada (ej: Examen, Taller, Tarea, Proyecto...)
  dueDate               DateTime? // Fecha asignada o fecha límite
  maxScore              Float?    @default(20)
  scores                Json? // Mapa de puntajes por estudiante: { "studentId": score }
  /// Alumnos evaluados de otra forma en esta actividad (p. ej. con el cuaderno
  /// quien no puede hacer deporte): { "studentId": { metodo, motivo? } }. Su
  /// nota va en `scores` y cuenta igual que la de los demás.
  evaluadoDeOtraForma   Json?
  /// Copia del instrumento de su evaluación del plan al empezar a calificarla:
  /// editar el plan después no cambia lo que ya significan las marcas.
  instrumento           Json?
  /// Las marcas de cada alumno en el instrumento y su total:
  /// { "studentId": { "marcas": { criterioId: valor }, "total": n | null } }.
  /// La nota sigue yendo a `scores`.
  detalleDelInstrumento Json?
  /// Quién puso la nota de cada alumno y cuándo: { "studentId": { usuarioId, en } }.
  /// Sirve para decir «el admin le puso 15 mientras estabas sin conexión».
  notasPuestasPor       Json?
  isDone                Boolean   @default(false)
  carriedOver           Boolean   @default(false) // true si fue movida por suspensión

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  // Vinculación de la actividad al criterio/bloque del plan de evaluación
  // (fila EVALUATION de la semana). Cada actividad de la Clase en Vivo pertenece
  // a un criterio del plan y participa en su cálculo ponderado.
  planRowId String?
  planRow   EvaluationPlanRow? @relation(fields: [planRowId], references: [id], onDelete: SetNull)

  classSessionId String?
  classSession   ClassSession? @relation(fields: [classSessionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classroomId, subjectId])
  @@index([classSessionId])
  @@index([classroomId, subjectId, target])
  @@map("class_activities")
}

// =====================================================
// WEBHOOK LOGS (Eventos del sistema)
// =====================================================

model WebhookLog {
  id          String     @id @default(cuid())
  event       String // INSTITUTE_CREATED, INSTITUTE_SUSPENDED, LIMIT_REACHED, etc.
  data        Json?
  createdAt   DateTime   @default(now())
  institute   Institute? @relation(fields: [instituteId], references: [id])
  instituteId String?

  @@index([event])
  @@index([createdAt])
  @@map("webhook_logs")
}

// =====================================================
// PAPELERA (nada se borra de verdad)
// =====================================================
//
// Antes de borrar una fila se guarda aquí una copia completa tal como estaba.
// No cambia cómo se consulta nada —las pantallas siguen igual— pero deja que un
// borrado por error se pueda deshacer.
//
// Un borrado equivocado de notas o de asistencia no se recupera de ningún otro
// sitio salvo del respaldo de anoche, que se lleva por delante todo lo del día.
// Esto es la red de seguridad del día en curso.

model RegistroBorrado {
  id         String @id @default(cuid())
  /// Nombre del modelo Prisma: "grade", "dailyAttendance", "observation"...
  tabla      String
  /// El id que tenía la fila borrada.
  registroId String
  /// La fila entera tal como estaba justo antes de borrarse.
  contenido  Json

  /// Quién lo borró y desde dónde, para poder preguntarle.
  borradoPor String?
  motivo     String?

  createdAt DateTime @default(now())

  @@index([tabla, registroId])
  @@index([createdAt])
  @@index([tabla, createdAt(sort: Desc)])
  @@map("registros_borrados")
}

/// EL COMEDOR (PAE): un módulo que el liceo activa o no, como los pagos.
/// Apagado, sus rutas responden 403. Una sola fila. Ver `services/pae.service.ts`.
model PaeConfig {
  id      String  @id @default("liceo")
  enabled Boolean @default(false)
  /// Las comidas que da el liceo: ["DESAYUNO", "ALMUERZO", "MERIENDA"].
  comidas Json

  updatedAt DateTime @updatedAt

  @@map("pae_config")
}

/// Lo del comedor de un día y una comida: raciones recibidas y servidas, el
/// menú y lo que haya que anotar. Solo el admin.
model PaeRegistro {
  id String @id @default(cuid())

  fecha         DateTime @db.Date
  /// DESAYUNO | ALMUERZO | MERIENDA
  comida        String
  recibidas     Int
  servidas      Int
  menu          String?
  observaciones String?
  registradoPor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fecha, comida])
  @@index([fecha])
  @@map("pae_registros")
}

/// EL INSTRUMENTO DE UNA EVALUACIÓN DEL PLAN
///
/// Lista de cotejo, escala de estimación, rúbrica o reparto por puntos (Ser,
/// Hacer, Conocer, Convivir). Aparte de la fila del plan a propósito: guardar el
/// plan compara filas «sin cambios» y una columna más la daría siempre por
/// cambiada (409 falsos a quien tiene el plan abierto). `version` sube en cada
/// guardado: dos profesores no se pisan. Ver `utils/instrumentos.ts`.
model InstrumentoDeEvaluacion {
  id String @id @default(cuid())

  planRowId String            @unique
  planRow   EvaluationPlanRow @relation(fields: [planRowId], references: [id], onDelete: Cascade)

  /// COTEJO | ESCALA | RUBRICA | PUNTOS
  tipo       String
  definicion Json
  version    Int    @default(1)
  /// Quién lo cambió por última vez: a quien se le pregunta si llegan marcas del anterior.
  cambiadoPor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("instrumentos_de_evaluacion")
}

/// LO HECHO SIN CONEXIÓN QUE YA LLEGÓ (2026-09-30)
///
/// Cada cambio llega con su id del teléfono (`X-Cambio`): el mismo id no se
/// aplica dos veces aunque se reenvíe días después (se devuelve la respuesta
/// de la primera vez). Y queda el rastro: cuándo se hizo y cuándo llegó.
/// `plugins/cambios-sin-conexion.ts`.
model CambioRecibido {
  id         String    @id
  usuarioId  String
  metodo     String
  ruta       String
  /// 0 = en curso; -1 = falló sin aplicarse (se puede reintentar); si no, el código HTTP.
  estado     Int       @default(0)
  respuesta  Json?
  hechoEn    DateTime?
  recibidoEn DateTime  @default(now())

  @@index([recibidoEn])
  @@map("cambios_recibidos")
}

/// LO QUE LLEGÓ SIN CONEXIÓN Y TIENE QUE DECIDIRLO OTRA PERSONA
///
/// Notas a una actividad que otro borró mientras tanto (decide quien la
/// borró: ¿la recupera con esas notas?), o marcas de un instrumento que otro
/// cambió (decide quien lo cambió: ¿sigue queriendo el nuevo?). Nada se pierde
/// en silencio. `services/cambios-en-espera.service.ts`.
model CambioEnEspera {
  id          String    @id @default(cuid())
  autorId     String
  decideId    String?
  /// NOTAS_A_ACTIVIDAD_BORRADA | MARCAS_CON_OTRO_INSTRUMENTO
  tipo        String
  /// El id de la actividad.
  objetivo    String
  datos       Json
  motivo      String
  hechoEn     DateTime?
  creadoEn    DateTime  @default(now())
  resuelto    Boolean   @default(false)
  resolucion  String?
  resueltoPor String?
  resueltoEn  DateTime?

  @@index([decideId, resuelto])
  @@index([autorId, resuelto])
  @@map("cambios_en_espera")
}

// =====================================================
// FINANZAS DEL LICEO (2026-10-01)
// =====================================================
//
// Cristian: «que sea para manejar sus finanzas»: los fondos del liceo, lo que
// deben los alumnos, lo que se paga a profesores y personal (con vacaciones) y
// los gastos sueltos. Todo el dinero en la moneda base del liceo, como Pagos;
// nada se borra: se anula con motivo.

/// Lo que entra que no es una cuota: el saldo con que el liceo empieza a usar
/// el sistema, una donación, otro ingreso.
model FondoDelLiceo {
  id          String   @id @default(cuid())
  fecha       DateTime @db.Date
  /// SALDO_INICIAL | DONACION | OTRO
  concepto    String
  descripcion String?
  moneda      String
  monto       Decimal  @db.Decimal(12, 2)
  tasa        Decimal? @db.Decimal(14, 4)
  /// El mismo monto en la moneda base del liceo.
  montoBase   Decimal  @db.Decimal(12, 2)

  creadoPorId     String?
  anuladoEn       DateTime?
  anuladoPorId    String?
  motivoAnulacion String?
  createdAt       DateTime  @default(now())

  @@index([fecha])
  @@map("fondos_del_liceo")
}

/// Un gasto suelto: un tablero de básquet, una reparación, el internet.
model Gasto {
  id        String   @id @default(cuid())
  fecha     DateTime @db.Date
  concepto  String
  categoria String
  proveedor String?
  notas     String?
  moneda    String
  monto     Decimal  @db.Decimal(12, 2)
  tasa      Decimal? @db.Decimal(14, 4)
  montoBase Decimal  @db.Decimal(12, 2)

  /// La foto de la factura (redibujada a WebP en el servidor).
  comprobanteId String?
  comprobante   Comprobante? @relation(fields: [comprobanteId], references: [id], onDelete: SetNull)

  creadoPorId     String?
  anuladoEn       DateTime?
  anuladoPorId    String?
  motivoAnulacion String?
  createdAt       DateTime  @default(now())

  @@index([fecha])
  @@map("gastos")
}

/// Una imagen de un papel de dinero: la factura de un gasto, la captura de un
/// pago móvil. Nunca la que se subió: el servidor la redibuja (sin metadatos,
/// sin nada escondido) a WebP de 1600 px como mucho.
model Comprobante {
  id          String   @id @default(cuid())
  data        Bytes
  tipo        String   @default("image/webp")
  tamano      Int
  subidoPorId String?
  createdAt   DateTime @default(now())

  gastos Gasto[]

  @@map("comprobantes")
}

/// Una persona a la que el liceo le paga: un profesor (con cuenta) u otro
/// personal (sin cuenta: la señora de la limpieza, el vigilante…).
model Personal {
  id     String  @id @default(cuid())
  /// Si tiene cuenta en el sistema (profesor o admin).
  userId String? @unique
  user   User?   @relation("PersonalConCuenta", fields: [userId], references: [id], onDelete: SetNull)
  /// Si no tiene cuenta, su nombre.
  nombre String?
  cedula String?
  cargo  String
  activo Boolean @default(true)
  /// Se trae solo al ciclo siguiente, con su mismo acuerdo.
  seQuedaParaProximosCiclos Boolean @default(true)
  notas  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  acuerdos AcuerdoDePago[]
  pagos    PagoAlPersonal[]

  @@map("personal")
}

/// Lo acordado con una persona en un ciclo: cuánto, cada cuánto, qué día y sus
/// vacaciones. Lo que queda en null toma el valor del liceo (`AjustesDeNomina`).
model AcuerdoDePago {
  id             String       @id @default(cuid())
  personalId     String
  personal       Personal     @relation(fields: [personalId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  /// Lo de CADA pago (en quincenal, cada quincena).
  monto      Decimal   @db.Decimal(12, 2)
  /// UNICO | MENSUAL | QUINCENAL
  frecuencia String    @default("MENSUAL")
  /// Día del mes (1–31; más que el mes = el último). Null = el del liceo.
  diaDePago  Int?
  /// Para el pago único.
  fechaUnica DateTime? @db.Date

  /// Null = lo que diga el liceo.
  cobraEnVacaciones Boolean?
  bonoVacacional    Decimal?  @db.Decimal(12, 2)
  fechaBono         DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([personalId, academicYearId])
  @@index([academicYearId])
  @@map("acuerdos_de_pago")
}

/// Lo del liceo para la nómina de un ciclo: el día de pago de todos, los meses
/// de vacaciones y el bono vacacional.
model AjustesDeNomina {
  academicYearId String       @id
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  /// Día del mes del pago mensual (31 = el último día del mes).
  diaDePago         Int      @default(31)
  /// Meses de vacaciones, como «AAAA-MM».
  mesesDeVacaciones Json     @default("[]")
  cobraEnVacaciones Boolean  @default(true)
  bonoVacacional    Decimal  @default(0) @db.Decimal(12, 2)
  fechaBono         DateTime? @db.Date

  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("ajustes_de_nomina")
}

/// Un pago hecho a una persona. No se borra: se anula con motivo.
model PagoAlPersonal {
  id             String       @id @default(cuid())
  /// Número correlativo del recibo.
  numero         Int          @unique @default(autoincrement())
  personalId     String
  personal       Personal     @relation(fields: [personalId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  fecha      DateTime @db.Date
  metodo     String
  referencia String?
  notas      String?
  moneda     String
  monto      Decimal  @db.Decimal(12, 2)
  tasa       Decimal? @db.Decimal(14, 4)
  montoBase  Decimal  @db.Decimal(12, 2)

  creadoPorId     String?
  anuladoEn       DateTime?
  anuladoPorId    String?
  motivoAnulacion String?
  createdAt       DateTime  @default(now())

  asignaciones AsignacionAlPersonal[]

  @@index([personalId, academicYearId])
  @@index([fecha])
  @@map("pagos_al_personal")
}

/// A qué pagos del acuerdo va cada pago al personal («S:2026-10», «B»…).
model AsignacionAlPersonal {
  id        String         @id @default(cuid())
  pagoId    String
  pago      PagoAlPersonal @relation(fields: [pagoId], references: [id], onDelete: Cascade)
  clave     String
  montoBase Decimal        @db.Decimal(12, 2)

  @@index([pagoId])
  @@map("asignaciones_al_personal")
}
