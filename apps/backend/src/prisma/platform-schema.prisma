generator client {
  provider = "prisma-client-js"
  output   = "../generated/platform-client"
}

datasource db {
  provider = "postgresql"
  url      = env("PLATFORM_DATABASE_URL")
}

model SuperAdmin {
  id            String                   @id @default(cuid())
  email         String                   @unique
  password      String
  name          String
  isActive      Boolean                  @default(true)
  lastLogin     DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  refreshTokens SuperAdminRefreshToken[]

  @@index([email])
  @@index([isActive])
  @@map("super_admins")
}

model SuperAdminRefreshToken {
  id           String     @id @default(cuid())
  token        String     @unique
  superAdminId String
  expiresAt    DateTime
  createdAt    DateTime   @default(now())
  superAdmin   SuperAdmin @relation(fields: [superAdminId], references: [id], onDelete: Cascade)

  @@index([superAdminId])
  @@index([expiresAt])
  @@map("super_admin_refresh_tokens")
}

model PlatformConfig {
  id              String   @id @default("platform")
  maintenanceMode Boolean  @default(false)
  supportEmail    String   @default("soporte@tuapp.com")
  platformName    String   @default("GestiEdu")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("platform_config")
}

model Institute {
  id               String                @id @default(cuid())
  name             String
  code             String                @unique
  // Opcional por decisión de producto: un instituto puede no tener email de contacto.
  email            String?
  phone            String?
  address          String?
  slug             String                @unique
  subdomain        String                @unique
  customDomain     String?               @unique
  environment      String                @default("development")
  status           InstituteStatus       @default(PENDING)
  trialEndsAt      DateTime?
  notes            String?
  databaseName     String?               @unique
  databaseHost     String?
  databasePort     Int?                  @default(5432)
  databaseUser     String?
  databasePassword String?
  adminId          String?               @unique
  timezone         String                @default("America/Caracas")
  country          String                @default("VE")
  city             String?
  academicConfig   Json?
  logo             String?
  favicon          String?
  primaryColor     String?               @default("#4F46E5")
  secondaryColor   String?               @default("#3B82F6")
  subjectPalette   String?
  plan             String                @default("BASIC")
  maxStudents      Int                   @default(2000)
  maxTeachers      Int                   @default(100)
  maxStorage       Int                   @default(5)
  currentStudents  Int                   @default(0)
  currentTeachers  Int                   @default(0)
  currentStorage   Float                 @default(0.0)
  monthlyPrice     Decimal               @default(50) @db.Decimal(10, 2)
  billingStatus    String                @default("ACTIVE")
  nextBillingDate  DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  invitations      InstituteInvitation[]
  webhookLogs      WebhookLog[]

  @@index([status])
  @@index([slug])
  @@index([subdomain])
  @@index([environment])
  @@map("institutes")
}

model InstituteInvitation {
  id          String    @id @default(cuid())
  email       String
  instituteId String
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([instituteId])
  @@index([token])
  @@map("institute_invitations")
}

model WebhookLog {
  id          String     @id @default(cuid())
  event       String
  payload     Json
  response    Json?
  status      String
  error       String?
  instituteId String?
  createdAt   DateTime   @default(now())
  institute   Institute? @relation(fields: [instituteId], references: [id])

  @@index([instituteId])
  @@index([event])
  @@index([status])
  @@map("webhook_logs")
}

enum InstituteStatus {
  ACTIVE
  SUSPENDED
  PENDING
  INACTIVE
  PROVISIONING
  FAILED
}
