// apps/backend/src/prisma/platform-schema.prisma
// Schema SEPARADO para la base de datos de plataforma (metadata)

generator client {
  provider = "prisma-client-js"
  output   = "../generated/platform-client"
}

datasource db {
  provider = "postgresql"
  url      = env("PLATFORM_DATABASE_URL")
}

// =====================================================
// ENUMS
// =====================================================

enum InstituteStatus {
  ACTIVE
  SUSPENDED
  PENDING
  INACTIVE
  PROVISIONING
  FAILED
}



// =====================================================
// SUPERADMIN
// =====================================================

model SuperAdmin {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String
  isActive  Boolean   @default(true)
  lastLogin DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens SuperAdminRefreshToken[]

  @@index([email])
  @@index([isActive])
  @@map("super_admins")
}

model SuperAdminRefreshToken {
  id           String     @id @default(cuid())
  token        String     @unique
  superAdminId String
  superAdmin   SuperAdmin @relation(fields: [superAdminId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime   @default(now())

  @@index([superAdminId])
  @@index([expiresAt])
  @@map("super_admin_refresh_tokens")
}

// =====================================================
// PLATFORM CONFIG
// =====================================================

model PlatformConfig {
  id              String  @id @default("platform")
  maintenanceMode Boolean @default(false)
  supportEmail    String  @default("soporte@tuapp.com")
  platformName    String  @default("GestiEdu")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_config")
}

// =====================================================
// INSTITUTES (Metadata de todos los institutos)
// =====================================================

model Institute {
  id        String  @id @default(cuid())
  name      String
  code      String  @unique
  email     String
  phone     String?
  address   String?
  slug      String  @unique

  // Sistema de subdominios
  subdomain    String  @unique // Obligatorio: sanmiguel, test-load, etc.
  customDomain String? @unique // Opcional para Premium: www.sanmiguel.edu.ve
  environment  String  @default("development") // 'development' | 'production'

  // Estado
  status      InstituteStatus @default(PENDING)
  trialEndsAt DateTime?
  notes       String?

  // Conexión a base de datos del tenant
  databaseName     String? @unique
  databaseHost     String?
  databasePort     Int?    @default(5432)
  databaseUser     String?
  databasePassword String?

  // Administrador del instituto
  adminId String? @unique // ID del admin en tenant DB

  // Ubicación
  timezone String  @default("America/Caracas")
  country  String  @default("VE")
  city     String?

  // Fase 3.5-C — Configuración académica del liceo (reglas de promoción).
  // JSON con: { notaMinimaAprobatoria: 10, maxMateriasPendientesParaPromover: 2,
  // permitePendientesEnUltimoAno: false } — editable por el admin del liceo.
  academicConfig Json?

  // Logos y branding
  logo           String?
  favicon        String?
  primaryColor   String? @default("#4F46E5")
  secondaryColor String? @default("#3B82F6")
  subjectPalette String?

  // ── Plan y Facturación ──────────────────────────────────────
  plan              String   @default("BASIC")  // BASIC | PREMIUM | ENTERPRISE
  maxStudents       Int      @default(2000)
  maxTeachers       Int      @default(100)
  maxStorage        Int      @default(5)        // En GB

  // Uso actual (actualizado por contadores atómicos)
  currentStudents   Int      @default(0)
  currentTeachers   Int      @default(0)
  currentStorage    Float    @default(0.0)      // En GB

  // Facturación
  monthlyPrice      Decimal  @default(50) @db.Decimal(10, 2)
  billingStatus     String   @default("ACTIVE") // ACTIVE | SUSPENDED | TRIAL
  nextBillingDate   DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones en platform DB
  invitations InstituteInvitation[]
  webhookLogs WebhookLog[]

  @@index([status])
  @@index([slug])
  @@index([subdomain])
  @@index([environment])
  @@map("institutes")
}

model InstituteInvitation {
  id          String    @id @default(cuid())
  email       String
  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([instituteId])
  @@index([token])
  @@map("institute_invitations")
}

// =====================================================
// WEBHOOK LOGS (Provisioning y eventos)
// =====================================================

model WebhookLog {
  id          String     @id @default(cuid())
  event       String
  payload     Json
  response    Json?
  status      String
  error       String?
  instituteId String?
  institute   Institute? @relation(fields: [instituteId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([instituteId])
  @@index([event])
  @@index([status])
  @@map("webhook_logs")
}
