{
  "name": "sistema-de-gestion-escolar",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@10.2.4",
  "scripts": {
    "telefono": "node scripts/servidores-para-el-telefono.mjs",
    "telefono:compilado": "node scripts/servidores-para-el-telefono.mjs --compilado",
    "telefono:usb": "node scripts/servidores-para-el-telefono.mjs --compilado --usb",
    "tunel": "node scripts/tunel.mjs",
    "movil": "node scripts/auditoria-del-telefono.mjs",
    "test:e2e": "playwright test -c playwright.config.ts",
    "test:seed": "npx tsx apps/backend/src/scripts/seed-load-test.ts",
    "test:seed:clean": "npx tsx apps/backend/src/scripts/seed-load-test.ts --clean"
  },
  "dependencies": {
    "motion-dom": "^12.29.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.0"
  },
  "overrides": {
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0",
    "uuid": "^11.1.1"
  }
}
