# =============================================================================
# GESTIEDU — Variables de Entorno de Ejemplo
# Copia este archivo como apps/backend/.env y ajusta los valores
# =============================================================================

# ── Servidor ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Bases de Datos (PostgreSQL) ───────────────────────────────────────────────
# Base de datos de la plataforma (SuperAdmin, metadatos de institutos)
PLATFORM_DATABASE_URL=postgresql://gestion_user:gestion_password@localhost:5432/gestion_escolar_platform

# Base de datos del tenant por defecto (se sobreescribe en runtime por X-Institute-Slug)
DATABASE_URL=postgresql://gestion_user:gestion_password@localhost:5432/tenant_instituto_testing

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=tu_redis_password  # Descomenta si Redis tiene contraseña

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_una_clave_secreta_de_al_menos_32_caracteres
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
SUPERADMIN_JWT_SECRET=cambia_esto_por_otra_clave_secreta_superadmin_32_chars

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=60000

# ── Email (Nodemailer, opcional) ───────────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu@email.com
# SMTP_PASS=tu_app_password
# SMTP_FROM="GestiEdu <no-reply@tuapp.com>"

# ── Archivos / Subidas ─────────────────────────────────────────────────────────
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── SuperAdmin (primer usuario de plataforma) ──────────────────────────────────
SUPERADMIN_EMAIL=admin@tuapp.com
SUPERADMIN_PASSWORD=cambia-esta-clave

# ── Multi-Tenant ───────────────────────────────────────────────────────────────
BASE_DOMAIN=tuapp.com
PLATFORM_NAME=GestiEdu

# ── Robustez (opcionales; el valor de al lado es el de por defecto) ────────────
# Cupo de renovar la sesión y de /health por dirección: un liceo entero sale
# por UNA dirección, así que es el cupo de un liceo, no el de una persona.
# CUPO_DEL_LICEO_POR_DIRECCION=3000
# Lo que la tarea diaria de mantenimiento tira, en días:
# PAPELERA_DIAS=90
# AVISOS_DIAS=180
# CAMBIOS_DIAS=90
# El certificado que sirve nginx: el panel del superadmin avisa 14 días antes.
# CERTIFICADO_TLS=/etc/letsencrypt/live/tuapp.com/fullchain.pem
# La copia de los respaldos que sale del servidor va cifrada con esta llave
# PÚBLICA (el PEM o la ruta al archivo). Sin ella, no sale. Ver DESPLIEGUE §8.
# RESPALDO_LLAVE_PUBLICA=/run/secrets/respaldos-publica.pem
